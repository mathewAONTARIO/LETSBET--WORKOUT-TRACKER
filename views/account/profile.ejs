<%- include('../partials/header', { currentPath: '/account/profile' }) %>

<%
  // Prefer explicit "user" from route, fall back to currentUser from session
  const u = user || currentUser;
%>

<div class="main-shell">
  <% if (saved) { %>
    <div
      class="alert alert-success py-2 mb-3"
      role="alert"
      style="background: rgba(22,163,74,0.16); border-color:#22c55e; color:#bbf7d0;"
    >
      Profile updated.
    </div>
  <% } %>

  <% if (reminder) { %>
    <div
      class="alert alert-success py-2 mb-3"
      role="alert"
      style="background: rgba(22,163,74,0.16); border-color:#22c55e; color:#bbf7d0;"
    >
      Reminder settings updated.
    </div>
  <% } %>

  <% if (error) { %>
    <div
      class="alert alert-danger py-2 mb-3"
      role="alert"
      style="background: rgba(248,113,113,0.18); border-color:#f97316; color:#fee2e2;"
    >
      Something went wrong while saving. Please try again.
    </div>
  <% } %>

  <div class="glass-card p-4 mb-4 d-flex flex-column flex-md-row align-items-start gap-4">
    <div class="d-flex flex-column align-items-center text-center">
      <% if (u && u.profilePhotoUrl) { %>
        <img
          src="<%= u.profilePhotoUrl %>"
          alt="Profile"
          style="width: 80px; height: 80px; border-radius: 999px; object-fit: cover; margin-bottom: 8px;"
        />
      <% } else { %>
        <div
          class="avatar-circle d-flex align-items-center justify-content-center"
          style="width: 80px; height: 80px; font-size: 2rem; margin-bottom: 8px;"
        >
          <%= (u && (u.displayName || u.email))
            ? (u.displayName || u.email).charAt(0).toUpperCase()
            : '?' %>
        </div>
      <% } %>

      <div>
        <h3 class="mb-0"><%= (u && (u.displayName || u.email)) || 'Athlete' %></h3>
        <p class="text-secondary mb-2" style="font-size: 0.9rem;">
          Weekly goal:
          <strong><%= (u && u.weeklyGoal) || 4 %> workouts</strong>
        </p>

        <a href="/account/settings" class="btn btn-outline-light btn-sm mt-1">
          Edit profile
        </a>
      </div>
    </div>

    <div class="flex-grow-1">
      <h5 class="mb-3">Athlete information</h5>

      <div class="row g-3">
        <div class="col-sm-6">
          <div class="text-secondary" style="font-size: 0.8rem;">Gender</div>
          <div>
            <% if (!u || !u.gender || u.gender === 'prefer-not-to-say') { %>
              Prefer not to say
            <% } else if (u.gender === 'male') { %>
              Male
            <% } else if (u.gender === 'female') { %>
              Female
            <% } else if (u.gender === 'non-binary') { %>
              Non-binary
            <% } else { %>
              Other
            <% } %>
          </div>
        </div>

        <div class="col-sm-6">
          <div class="text-secondary" style="font-size: 0.8rem;">Age</div>
          <div><%= (u && typeof u.age === 'number') ? u.age : '—' %></div>
        </div>

        <div class="col-sm-6">
          <div class="text-secondary" style="font-size: 0.8rem;">Height</div>
          <div>
            <% if (u && u.heightValue) { %>
              <%= u.heightValue %> <%= u.heightUnit || 'cm' %>
            <% } else { %>
              —
            <% } %>
          </div>
        </div>

        <div class="col-sm-6">
          <div class="text-secondary" style="font-size: 0.8rem;">Weight</div>
          <div>
            <% if (u && u.weightValue) { %>
              <%= u.weightValue %> <%= u.weightUnit || 'kg' %>
            <% } else { %>
              —
            <% } %>
          </div>
        </div>

        <div class="col-sm-6">
          <div class="text-secondary" style="font-size: 0.8rem;">Primary goal</div>
          <div>
            <% if (!u || !u.primaryGoal || u.primaryGoal === 'general-fitness') { %>
              General fitness
            <% } else if (u.primaryGoal === 'fat-loss') { %>
              Fat loss
            <% } else if (u.primaryGoal === 'muscle-gain') { %>
              Muscle gain
            <% } else if (u.primaryGoal === 'strength') { %>
              Strength
            <% } else if (u.primaryGoal === 'performance') { %>
              Performance
            <% } else if (u.primaryGoal === 'endurance') { %>
              Endurance
            <% } else { %>
              Other
            <% } %>
          </div>
        </div>

        <div class="col-sm-6">
          <div class="text-secondary" style="font-size: 0.8rem;">Training experience</div>
          <div>
            <% if (!u || !u.trainingExperience || u.trainingExperience === 'beginner-0-6') { %>
              Beginner (0–6 months)
            <% } else if (u.trainingExperience === 'intermediate-6-24') { %>
              Intermediate (6–24 months)
            <% } else if (u.trainingExperience === 'advanced-24-plus') { %>
              Advanced (2+ years)
            <% } else { %>
              —
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="glass-card p-4 mb-4">
    <h5 class="mb-2">Workout reminders</h5>
    <p class="text-secondary" style="font-size: 0.9rem;">
      Daily reminder:
      <% if (u && u.dailyReminderEnabled) { %>
        <strong>On</strong> at <strong><%= u.reminderTime || '18:00' %></strong>
      <% } else { %>
        <strong>Off</strong>
      <% } %>
    </p>
    <a href="/account/settings" class="btn btn-outline-light btn-sm">
      Edit reminder settings
    </a>
  </div>

  <p class="text-secondary" style="font-size: 0.85rem;">
    Future versions can add your weekly distance, total time, and PR timeline here — just like
    your Strava profile.
  </p>
</div>

<%- include('../partials/footer') %>