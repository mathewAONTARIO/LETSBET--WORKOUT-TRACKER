<%- include('../partials/header', { currentPath: '/account/profile' }) %>

<div class="main-shell">
  <h2 class="mb-1">Settings</h2>
  <p class="text-secondary mb-4">
    Update your profile, training preferences, and workout reminders.
  </p>

  <% if (saved) { %>
    <div class="alert alert-success py-2 mb-3" role="alert" style="background: rgba(22,163,74,0.16); border-color:#22c55e; color:#bbf7d0;">
      Profile saved successfully.
    </div>
  <% } %>

  <% if (error) { %>
    <div class="alert alert-danger py-2 mb-3" role="alert" style="background: rgba(248,113,113,0.18); border-color:#f97316; color:#fee2e2;">
      Something went wrong while saving. Please try again.
    </div>
  <% } %>

  <form
    action="/account/profile"
    method="POST"
    enctype="multipart/form-data"
  >
    <div class="glass-card p-4 mb-4">
      <h5 class="mb-3">Profile</h5>

      <!-- Avatar row -->
      <div class="mb-3">
        <label class="form-label">Profile picture</label>
        <div class="d-flex align-items-center gap-3 flex-wrap">
          <% if (user && user.profilePhotoUrl) { %>
            <img
              src="<%= user.profilePhotoUrl %>"
              alt="Profile"
              style="width: 56px; height: 56px; border-radius: 999px; object-fit: cover;"
            />
          <% } else { %>
            <div
              style="
                width: 56px;
                height: 56px;
                border-radius: 999px;
                background: rgba(15,23,42,0.9);
                border: 1px solid rgba(148,163,184,0.6);
                display:flex;
                align-items:center;
                justify-content:center;
                font-size: 1.1rem;
              "
            >
              <%= (user && (user.displayName || user.email))
                    ? (user.displayName || user.email).charAt(0).toUpperCase()
                    : '?' %>
            </div>
          <% } %>

          <div class="flex-grow-1" style="max-width: 260px;">
            <input
              type="file"
              name="profilePhoto"
              accept="image/png,image/jpeg"
              class="form-control"
            />
            <small class="text-secondary">
              PNG or JPG, up to 2MB.
            </small>
          </div>
        </div>
      </div>

      <!-- Display name + weekly goal -->
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label">Display name</label>
          <input
            type="text"
            name="displayName"
            class="form-control"
            value="<%= user.displayName || '' %>"
          />
        </div>

        <div class="col-md-6">
          <label class="form-label">Weekly workout goal</label>
          <select name="weeklyGoal" class="form-select">
            <% [3,4,5,6,7].forEach(function(goal) { %>
              <option
                value="<%= goal %>"
                <%= (user.weeklyGoal || 4) === goal ? 'selected' : '' %>>
                <%= goal %> per week
              </option>
            <% }) %>
          </select>
        </div>
      </div>

      <!-- Gender / Age -->
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label">Gender</label>
          <select name="gender" class="form-select">
            <option value="" <%= !user.gender ? 'selected' : '' %>>Prefer not to say</option>
            <option value="male" <%= user.gender === 'male' ? 'selected' : '' %>>Male</option>
            <option value="female" <%= user.gender === 'female' ? 'selected' : '' %>>Female</option>
            <option value="other" <%= user.gender === 'other' ? 'selected' : '' %>>Other</option>
          </select>
        </div>

        <div class="col-md-6">
          <label class="form-label">Age</label>
          <input
            type="number"
            name="age"
            min="0"
            max="120"
            class="form-control"
            value="<%= typeof user.age === 'number' ? user.age : '' %>"
          />
        </div>
      </div>

      <!-- Height & Weight (text so you can use ' and .) -->
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label">Height</label>
          <div class="input-group">
            <input
              type="text"
              name="height"
              class="form-control"
              placeholder="e.g. 5'11 or 180"
              value="<%= user.height || '' %>"
            />
            <select name="heightUnit" class="form-select" style="max-width: 90px;">
              <option value="cm" <%= (user.heightUnit || 'cm') === 'cm' ? 'selected' : '' %>>cm</option>
              <option value="ft" <%= user.heightUnit === 'ft' ? 'selected' : '' %>>ft</option>
            </select>
          </div>
        </div>

        <div class="col-md-6">
          <label class="form-label">Weight</label>
          <div class="input-group">
            <input
              type="text"
              name="weight"
              class="form-control"
              placeholder="e.g. 72.5"
              value="<%= user.weight || '' %>"
            />
            <select name="weightUnit" class="form-select" style="max-width: 90px;">
              <option value="kg" <%= (user.weightUnit || 'kg') === 'kg' ? 'selected' : '' %>>kg</option>
              <option value="lb" <%= user.weightUnit === 'lb' ? 'selected' : '' %>>lb</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Goals / Level -->
      <div class="row g-3 mb-2">
        <div class="col-md-6">
          <label class="form-label">Primary goal</label>
          <select name="primaryGoal" class="form-select">
            <option value="" <%= !user.primaryGoal ? 'selected' : '' %>>Select goal</option>
            <option value="fat-loss" <%= user.primaryGoal === 'fat-loss' ? 'selected' : '' %>>Lose fat</option>
            <option value="muscle-gain" <%= user.primaryGoal === 'muscle-gain' ? 'selected' : '' %>>Build muscle</option>
            <option value="performance" <%= user.primaryGoal === 'performance' ? 'selected' : '' %>>Performance / Sports</option>
            <option value="general-health" <%= user.primaryGoal === 'general-health' ? 'selected' : '' %>>General health</option>
          </select>
        </div>

        <div class="col-md-6">
          <label class="form-label">Training experience</label>
          <select name="trainingLevel" class="form-select">
            <option value="" <%= !user.trainingLevel ? 'selected' : '' %>>Select level</option>
            <option value="beginner" <%= user.trainingLevel === 'beginner' ? 'selected' : '' %>>Beginner</option>
            <option value="intermediate" <%= user.trainingLevel === 'intermediate' ? 'selected' : '' %>>Intermediate</option>
            <option value="advanced" <%= user.trainingLevel === 'advanced' ? 'selected' : '' %>>Advanced</option>
          </select>
        </div>
      </div>

      <div class="mt-3">
        <button type="submit" class="btn btn-primary w-100">
          Save profile
        </button>
      </div>
    </div>

    <!-- Reminders card -->
    <div class="glass-card p-4 mb-4">
      <h5 class="mb-3">Workout reminders</h5>
      <p class="text-secondary" style="font-size: 0.85rem;">
        Set a daily time to remind yourself to log workouts. (Future versions could send real notifications.)
      </p>

      <div class="form-check form-switch mb-3">
        <input
          class="form-check-input"
          type="checkbox"
          id="reminderEnabled"
          name="reminderEnabled"
          <%= user.reminderEnabled ? 'checked' : '' %>
        />
        <label class="form-check-label" for="reminderEnabled">
          Enable daily reminder
        </label>
      </div>

      <div class="mb-2" style="max-width: 220px;">
        <label class="form-label">Reminder time</label>
        <input
          type="time"
          name="reminderTime"
          class="form-control"
          value="<%= user.reminderTime || '18:00' %>"
        />
        <small class="text-secondary">
          This just stores your preferred time for now.
        </small>
      </div>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>