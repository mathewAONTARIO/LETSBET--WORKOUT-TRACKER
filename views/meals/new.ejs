<%- include('../partials/header', { currentPath: '/meals/new', title: 'Meals' }) %>

<div class="main-shell">
  <h2 class="mb-1"><%= duplicateOf ? 'Duplicate Meal' : 'Add Meal' %></h2>
  <p class="text-secondary mb-4">
    Log your calories for the day.
  </p>

  <form action="<%= formAction %>" method="POST" class="glass-card p-4">
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Meal name</label>
        <input
          type="text"
          name="name"
          class="form-control"
          placeholder="Chicken & rice, protein shake, etc."
          value="<%= duplicateOf ? (duplicateOf.name || '') : '' %>"
          required
        />
      </div>

      <div class="col-md-3">
        <label class="form-label">Calories</label>
        <input
          type="number"
          name="calories"
          class="form-control"
          min="0"
          value="<%= duplicateOf ? (duplicateOf.calories ?? '') : '' %>"
          required
        />
      </div>

      <div class="col-md-3">
        <label class="form-label">Time of day</label>
        <select name="timeOfDay" class="form-select">
          <option value="">-- Select --</option>
          <option value="Breakfast" <%= duplicateOf && duplicateOf.timeOfDay === 'Breakfast' ? 'selected' : '' %>>Breakfast</option>
          <option value="Lunch" <%= duplicateOf && duplicateOf.timeOfDay === 'Lunch' ? 'selected' : '' %>>Lunch</option>
          <option value="Dinner" <%= duplicateOf && duplicateOf.timeOfDay === 'Dinner' ? 'selected' : '' %>>Dinner</option>
          <option value="Snack" <%= duplicateOf && duplicateOf.timeOfDay === 'Snack' ? 'selected' : '' %>>Snack</option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Protein (g)</label>
        <input
          type="number"
          step="0.1"
          name="protein"
          class="form-control"
          min="0"
          value="<%= duplicateOf ? (duplicateOf.protein ?? '') : '' %>"
        />
      </div>

      <div class="col-md-3">
        <label class="form-label">Carbs (g)</label>
        <input
          type="number"
          step="0.1"
          name="carbs"
          class="form-control"
          min="0"
          value="<%= duplicateOf ? (duplicateOf.carbs ?? '') : '' %>"
        />
      </div>

      <div class="col-md-3">
        <label class="form-label">Fats (g)</label>
        <input
          type="number"
          step="0.1"
          name="fats"
          class="form-control"
          min="0"
          value="<%= duplicateOf ? (duplicateOf.fats ?? '') : '' %>"
        />
      </div>

      <div class="col-md-3">
        <label class="form-label">Date</label>
        <input
          type="date"
          name="date"
          class="form-control"
          value="<%=
            duplicateOf && duplicateOf.date
              ? new Date(duplicateOf.date).toISOString().slice(0, 10)
              : today
          %>"
        />
      </div>

      <div class="col-12">
        <label class="form-label">Notes</label>
        <textarea
          name="notes"
          class="form-control"
          rows="2"
          placeholder="Any extra details..."
        ><%= duplicateOf ? (duplicateOf.notes || '') : '' %></textarea>
      </div>
    </div>

    <div class="mt-4 d-flex gap-2">
      <button type="submit" class="btn btn-primary">Save Meal</button>
      <a href="/meals" class="btn btn-outline-light">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>