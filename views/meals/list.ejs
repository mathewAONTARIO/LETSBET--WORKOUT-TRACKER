<%- include('../partials/header', { title: 'Meals' }) %>

<div class="main-shell">
  <!-- Page header -->
  <section class="mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h1 class="mb-1">Meals</h1>
        <p class="mb-1 text-secondary">
          Log your meals to keep calories and macros on track.
        </p>
        <p class="mb-0 text-secondary">
          Today’s total:
          <strong><%= todayCalories || 0 %> kcal</strong>
        </p>
      </div>

      <div>
        <a href="/meals/new" class="btn btn-primary btn-lg btn-pill">
          Add Meal
        </a>
      </div>
    </div>
  </section>

  <!-- Meals list -->
  <section class="glass-card meal-card-shell mt-3">
    <% if (!meals || meals.length === 0) { %>
      <p class="mb-0 text-secondary">
        No meals logged yet. Tap <strong>Add Meal</strong> to add your first one.
      </p>
    <% } else { %>
      <table class="meal-table">
        <thead>
          <tr>
            <th scope="col">Meal</th>
            <th scope="col">Calories</th>
            <th scope="col">Time</th>
            <th scope="col">Date</th>
            <th scope="col" style="width: 240px;">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% meals.forEach(meal => { %>
            <tr>
              <!-- Meal name + macros -->
              <td data-label="Meal">
                <div class="fw-semibold text-capitalize"><%= meal.name %></div>
                <div class="meal-macros">
                  P: <%= meal.protein || 0 %>g ·
                  C: <%= meal.carbs || 0 %>g ·
                  F: <%= meal.fats || 0 %>g
                </div>
              </td>

              <!-- Calories -->
              <td data-label="Calories">
                <%= meal.calories || 0 %>
              </td>

              <!-- Time -->
              <td data-label="Time">
                <%= meal.timeOfDay || '—' %>
              </td>

              <!-- Date -->
              <td data-label="Date">
                <% if (meal.date) { %>
                  <%= new Date(meal.date).toLocaleDateString() %>
                <% } else { %>—<% } %>
              </td>

              <!-- Actions -->
              <td data-label="Actions">
                <div class="d-flex gap-2 flex-wrap justify-content-end">
                  <a class="btn btn-outline-light btn-sm" href="/meals/<%= meal._id %>/duplicate">Duplicate</a>
                  <a class="btn btn-outline-light btn-sm" href="/meals/<%= meal._id %>/edit">Edit</a>
                  <a class="btn btn-danger btn-sm" href="/meals/<%= meal._id %>/delete">Delete</a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>

<%- include('../partials/footer') %>