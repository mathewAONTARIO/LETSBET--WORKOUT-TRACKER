<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Meals – LetsBetFit</title>
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body class="page-body">
  <%- include('../partials/header', { currentPath }) %>

  <main class="page-main">
    <section class="page-section">
      <div class="section-header">
        <div>
          <h1 class="section-title">Meals</h1>
          <p class="section-subtitle">
            Log your meals to keep calories and macros on track.
          </p>
          <p class="section-meta">
            Today’s total: <strong><%= todayCalories %> kcal</strong>
          </p>
        </div>
        <a href="/meals/new" class="btn btn-primary">Add Meal</a>
      </div>

      <% if (!meals || meals.length === 0) { %>
        <div class="card empty-card">
          <p>No meals logged yet.</p>
          <a href="/meals/new" class="btn btn-primary">Log your first meal</a>
        </div>
      <% } else { %>
        <div class="card table-card">
          <table class="data-table">
            <thead>
              <tr>
                <th>Meal</th>
                <th>Calories</th>
                <th>Macros</th>
                <th>Time</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% meals.forEach(function(m) { %>
                <tr>
                  <td><strong><%= m.name %></strong></td>
                  <td><%= m.calories || 0 %></td>
                  <td>
                    P: <%= m.protein || 0 %>g ·
                    C: <%= m.carbs || 0 %>g ·
                    F: <%= m.fats || 0 %>g
                  </td>
                  <td><%= m.timeOfDay || '—' %></td>
                  <td>
                    <% if (m.date) { %>
                      <%= new Date(m.date).toLocaleDateString() %>
                    <% } else { %>
                      —
                    <% } %>
                  </td>
                  <td class="table-actions">
                    <a href="/meals/<%= m._id %>/edit" class="btn btn-ghost">Edit</a>
                    <form action="/meals/<%= m._id %>/delete" method="POST" class="inline-form">
                      <button type="submit" class="btn btn-danger-outline">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>