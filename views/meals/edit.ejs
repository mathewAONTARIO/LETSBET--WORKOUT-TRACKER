<%- include('../partials/header', { currentPath: '/meals' }) %>

<div class="main-shell">
  <div class="mb-3">
    <a href="/meals" class="text-secondary" style="font-size: 0.85rem;">
      ← Back to meals
    </a>
  </div>

  <div class="glass-card p-4">
    <h2 class="mb-2">Edit meal</h2>
    <p class="text-secondary mb-3" style="font-size: 0.9rem;">
      Adjust calories, macros, or notes for this entry.
    </p>

    <form
      action="/meals/<%= meal._id %>/edit"
      method="POST"
      class="row g-3"
    >
      <div class="col-md-6">
        <label class="form-label">Meal name</label>
        <input
          type="text"
          name="name"
          class="form-control"
          value="<%= meal.name || '' %>"
          required
        />
      </div>

      <div class="col-md-6">
        <label class="form-label">Calories</label>
        <input
          type="number"
          name="calories"
          class="form-control"
          min="0"
          value="<%= meal.calories || 0 %>"
        />
      </div>

      <div class="col-md-4">
        <label class="form-label">Protein (g)</label>
        <input
          type="number"
          step="0.1"
          name="protein"
          class="form-control"
          min="0"
          value="<%= meal.protein || 0 %>"
        />
      </div>

      <div class="col-md-4">
        <label class="form-label">Carbs (g)</label>
        <input
          type="number"
          step="0.1"
          name="carbs"
          class="form-control"
          min="0"
          value="<%= meal.carbs || 0 %>"
        />
      </div>

      <div class="col-md-4">
        <label class="form-label">Fat (g)</label>
        <input
          type="number"
          step="0.1"
          name="fats"
          class="form-control"
          min="0"
          value="<%= (meal.fats || meal.fat || 0) %>"
        />
      </div>

      <div class="col-md-6">
        <label class="form-label">Date</label>
        <input
          type="date"
          name="date"
          class="form-control"
          value="<%= meal.date ? meal.date.toISOString().slice(0, 10) : '' %>"
        />
      </div>

      <div class="col-md-6">
        <label class="form-label">Time of day</label>
        <select name="timeOfDay" class="form-select">
          <option value="">Select</option>
          <option value="Breakfast" <%= meal.timeOfDay === 'Breakfast' ? 'selected' : '' %>>
            Breakfast
          </option>
          <option value="Lunch" <%= meal.timeOfDay === 'Lunch' ? 'selected' : '' %>>
            Lunch
          </option>
          <option value="Dinner" <%= meal.timeOfDay === 'Dinner' ? 'selected' : '' %>>
            Dinner
          </option>
          <option value="Snack" <%= meal.timeOfDay === 'Snack' ? 'selected' : '' %>>
            Snack
          </option>
        </select>
      </div>

      <div class="col-12">
        <label class="form-label">Notes</label>
        <textarea
          name="notes"
          class="form-control"
          rows="3"
          placeholder="Optional notes (e.g. brand, recipe, how you felt)"
        ><%= meal.notes || '' %></textarea>
      </div>

      <div class="col-12 d-flex justify-content-between mt-2">
        <a href="/meals" class="btn btn-outline-light btn-pill">
          Cancel
        </a>
        <button type="submit" class="btn btn-primary btn-pill">
          Save changes
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>