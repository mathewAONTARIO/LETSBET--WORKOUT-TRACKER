<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>LETSBETFit</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="theme-color" content="#020617" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <link rel="icon" href="/img/logo/lb-icon.png" />
    <link rel="apple-touch-icon" href="/img/logo/lb-icon.png" />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />

    <link rel="stylesheet" href="/css/style.css?v=<%= (process.env.ASSET_VERSION || '1') %>" />
    <link rel="manifest" href="/manifest.json" />
  </head>

  <body class="<%= currentTheme === 'light' ? 'theme-light' : '' %>">
    <nav class="navbar navbar-dark navbar-expand-lg border-bottom mb-4">
      <div class="container px-3">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/">
          <img class="brand-mark" src="/img/logo/lb-logo.png" alt="LetsBet Fit" />
          <span class="brand-wordmark">
            <span class="brand-text-main">LETSBET</span>
            <span class="brand-text-sub">Fit</span>
          </span>
        </a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNav"
          aria-controls="mainNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse mt-2 mt-lg-0" id="mainNav">
          <% if (currentUser) { %>
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
              <li class="nav-item"><a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a></li>
              <li class="nav-item"><a class="nav-link <%= currentPath === '/workouts' ? 'active' : '' %>" href="/workouts">Workouts</a></li>
              <li class="nav-item"><a class="nav-link <%= (currentPath || '').startsWith('/meals') ? 'active' : '' %>" href="/meals">Meals</a></li>
              <li class="nav-item"><a class="nav-link <%= currentPath === '/workouts/calendar' ? 'active' : '' %>" href="/workouts/calendar">Calendar</a></li>
            </ul>

            <div class="d-flex align-items-center gap-2">
              <form action="/account/theme" method="POST" class="m-0">
                <input type="hidden" name="theme" value="<%= currentTheme === 'light' ? 'dark' : 'light' %>" />
                <input type="hidden" name="next" value="<%= currentPath || '/' %>" />
                <button type="submit" class="btn btn-outline-light btn-sm">
                  <%= currentTheme === 'light' ? '🌙' : '☀️' %>
                </button>
              </form>

              <div class="dropdown">
                <button class="btn btn-outline-light btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                  <%= currentUser.displayName || currentUser.email %>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li><a class="dropdown-item" href="/workouts/streak">Streak</a></li>
                  <li><a class="dropdown-item" href="/workouts/stats">Stats</a></li>
                  <li><a class="dropdown-item" href="/workouts/library">Library</a></li>
                  <li><a class="dropdown-item" href="/insights">Insights</a></li>
                  <li><a class="dropdown-item" href="/account/settings">Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li>
                    <form action="/auth/logout" method="POST" class="m-0">
                      <button class="dropdown-item text-danger" type="submit">Log out</button>
                    </form>
                  </li>
                </ul>
              </div>
            </div>
          <% } else { %>
            <div class="ms-auto d-flex gap-2">
              <a href="/auth/login" class="btn btn-outline-light btn-sm">Log In</a>
              <a href="/auth/register" class="btn btn-primary btn-sm">Sign Up</a>
            </div>
          <% } %>
        </div>
      </div>
    </nav>

    <main class="main-shell mb-5">