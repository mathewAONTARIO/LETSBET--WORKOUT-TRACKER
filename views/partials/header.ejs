<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Lets Bet</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="bg-dark text-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-secondary">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <img src="/img/letsbet-logo.png" alt="Lets Bet logo" style="height:28px;width:auto;" />
      <span class="fw-bold text-uppercase" style="letter-spacing:0.08em;">Lets Bet</span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div id="nav" class="collapse navbar-collapse">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath.startsWith('/workouts') && !currentPath.includes('streak') && !currentPath.includes('stats') && !currentPath.includes('calendar') && !currentPath.includes('settings') ? 'active' : '' %>" href="/workouts">Workouts</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/workouts/streak' ? 'active' : '' %>" href="/workouts/streak">Streak</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/workouts/stats' ? 'active' : '' %>" href="/workouts/stats">Stats</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/workouts/calendar' ? 'active' : '' %>" href="/workouts/calendar">Calendar</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/workouts/settings' ? 'active' : '' %>" href="/workouts/settings">Settings</a>
        </li>
      </ul>

      <div class="d-flex gap-2">
        <% if (!currentUser) { %>
          <a href="/auth/login" class="btn btn-outline-light btn-sm">Log In</a>
          <a href="/auth/register" class="btn btn-primary btn-sm">Sign Up</a>
        <% } else { %>
          <form action="/auth/logout" method="POST" class="d-inline">
            <button type="submit" class="btn btn-outline-light btn-sm">Log Out</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<main class="container py-4">