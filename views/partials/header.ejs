<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>LetsBet Fit</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />

    <!-- Custom styles -->
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="manifest" href="/manifest.json" />
  </head>

  <body class="<%= currentTheme === 'light' ? 'theme-light' : '' %>">
    <nav class="navbar navbar-dark navbar-expand-lg border-bottom border-slate-800 mb-4">
      <div class="container px-3">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/">
          <img
            src="/img/letsbet-logo.png"
            alt="LetsBet Fit"
            style="width: 26px; height: 26px; border-radius: 6px; object-fit: cover;"
          />
          <span class="fw-semibold text-uppercase" style="font-size: 0.9rem;">
            LETSBET FIT
          </span>
        </a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNav"
          aria-controls="mainNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse mt-2 mt-lg-0" id="mainNav">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <% if (currentUser) { %>
              <li class="nav-item">
                <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a>
              </li>
              <li class="nav-item">
                <a class="nav-link <%= currentPath === '/workouts' ? 'active' : '' %>" href="/workouts">Workouts</a>
              </li>
              <li class="nav-item">
                <a class="nav-link <%= currentPath === '/workouts/streak' ? 'active' : '' %>" href="/workouts/streak">Streak</a>
              </li>
              <li class="nav-item">
                <a class="nav-link <%= currentPath === '/workouts/stats' ? 'active' : '' %>" href="/workouts/stats">Stats</a>
              </li>
              <li class="nav-item">
                <a class="nav-link <%= currentPath === '/workouts/calendar' ? 'active' : '' %>" href="/workouts/calendar">Calendar</a>
              </li>
              <li class="nav-item">
                <a class="nav-link <%= currentPath === '/workouts/library' ? 'active' : '' %>" href="/workouts/library">Library</a>
              </li>
              <li class="nav-item">
                <a class="nav-link <%= currentPath.startsWith('/meals') ? 'active' : '' %>" href="/meals">Meals</a>
              </li>
              <li class="nav-item">
                <a class="nav-link <%= currentPath === '/workouts/settings' ? 'active' : '' %>" href="/workouts/settings">Settings</a>
              </li>
            <% } %>
          </ul>

          <div class="d-flex align-items-center gap-3">

            <!-- Theme toggle -->
            <form id="themeToggleForm" action="/account/theme" method="POST" class="me-1">
              <input type="hidden" name="theme" value="<%= currentTheme === 'light' ? 'dark' : 'light' %>" />
              <button type="submit" class="btn btn-outline-light btn-sm d-flex align-items-center theme-toggle-btn">
                <% if (currentTheme === 'light') { %>🌙<% } else { %>☀️<% } %>
              </button>
            </form>

            <% if (currentUser) { %>
              <div class="profile-pill">
                <% if (currentUser.profilePhotoUrl) { %>
                  <img
                    src="<%= currentUser.profilePhotoUrl %>"
                    alt="Profile"
                    style="width: 22px; height: 22px; border-radius: 999px; object-fit: cover; margin-right: 6px;"
                  />
                <% } else { %>
                  <span class="avatar-circle me-2">
                    <%= currentUser.displayName
                      ? currentUser.displayName.charAt(0).toUpperCase()
                      : (currentUser.email || '?').charAt(0).toUpperCase() %>
                  </span>
                <% } %>
                <span style="font-size: 0.85rem;"><%= currentUser.displayName || currentUser.email %></span>
              </div>

              <form action="/auth/logout" method="POST" class="ms-2">
                <button class="btn btn-outline-light btn-sm" type="submit">Log Out</button>
              </form>

            <% } else { %>
              <a href="/auth/login" class="btn btn-outline-light btn-sm">Log In</a>
              <a href="/auth/register" class="btn btn-primary btn-sm ms-1">Sign Up</a>
            <% } %>

          </div>
        </div>
      </div>
    </nav>

    <main class="container mb-5 main-shell">