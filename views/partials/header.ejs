<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Lets Bet</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="bg-dark text-light">

<header class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-secondary">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center" href="/">
      <img src="/img/letsbet-logo.png" alt="Lets Bet logo" class="me-2" style="height: 26px;" />
      <span class="fw-bold text-uppercase">Lets Bet</span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <nav class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath.startsWith('/workouts') ? 'active' : '' %>" href="/workouts">Workouts</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath.includes('/streak') ? 'active' : '' %>" href="/workouts/streak">Streak</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath.includes('/stats') ? 'active' : '' %>" href="/workouts/stats">Stats</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath.includes('/calendar') ? 'active' : '' %>" href="/workouts/calendar">Calendar</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath.includes('/settings') ? 'active' : '' %>" href="/workouts/settings">Settings</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<main class="container mt-5">