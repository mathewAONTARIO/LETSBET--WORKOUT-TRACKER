<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Lets Bet</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="application-name" content="Lets Bet" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="bg-dark text-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-secondary">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <img src="/img/letsbet-logo.png" alt="Lets Bet logo" style="height:28px;width:auto;" />
      <span class="fw-bold text-uppercase" style="letter-spacing:0.08em;">Lets Bet</span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div id="nav" class="collapse navbar-collapse">
      <ul class="navbar-nav ms-auto me-3">
        <li class="nav-item">
          <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'active' : '' %>" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/workouts') && !['/workouts/streak','/workouts/stats','/workouts/calendar','/workouts/settings'].includes(currentPath) ? 'active' : '' %>" href="/workouts">Workouts</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/workouts/streak' ? 'active' : '' %>" href="/workouts/streak">Streak</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/workouts/stats' ? 'active' : '' %>" href="/workouts/stats">Stats</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/workouts/calendar' ? 'active' : '' %>" href="/workouts/calendar">Calendar</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/workouts/settings' ? 'active' : '' %>" href="/workouts/settings">Settings</a>
        </li>
      </ul>

      <div class="d-none d-lg-flex align-items-center text-secondary small">
        <div class="profile-pill">
          <span class="avatar-circle">M</span>
          <span class="ms-2">Mathew</span>
        </div>
      </div>
    </div>
  </div>
</nav>

<main class="container py-4">