<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>LETSBETFit</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />

    <link rel="stylesheet" href="/css/style.css" />
    <link rel="manifest" href="/manifest.json" />
  </head>

  <body class="<%= currentTheme === 'light' ? 'theme-light' : '' %>">
    <nav class="navbar navbar-dark navbar-expand-lg border-bottom border-slate-800 mb-4">
      <div class="container px-3">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <defs>
              <linearGradient id="lbfit-grad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#60a5fa" />
                <stop offset="100%" stop-color="#22c55e" />
              </linearGradient>
            </defs>
            <rect x="2.5" y="2.5" width="27" height="27" rx="8" ry="8" fill="url(#lbfit-grad)" />
            <polyline
              points="5 18 10 18 13 11 17 23 20 16 24 18 27 18"
              fill="none"
              stroke="#0b1120"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>

          <span class="brand-wordmark">
            <span class="brand-text-main">LETSBET</span>
            <span class="brand-text-sub">Fit</span>
          </span>
        </a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNav"
          aria-controls="mainNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse mt-2 mt-lg-0" id="mainNav">
          <% if (currentUser) { %>
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
              <li class="nav-item">
                <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a>
              </li>

              <li class="nav-item">
                <a class="nav-link <%= currentPath === '/workouts' ? 'active' : '' %>" href="/workouts">Workouts</a>
              </li>

              <li class="nav-item">
                <a class="nav-link <%= (currentPath && currentPath.startsWith('/meals')) ? 'active' : '' %>" href="/meals">Meals</a>
              </li>

              <li class="nav-item">
                <a class="nav-link <%= currentPath === '/workouts/calendar' ? 'active' : '' %>" href="/workouts/calendar">Calendar</a>
              </li>
            </ul>

            <div class="d-flex align-items-center gap-2">
              <form action="/account/theme" method="POST" class="me-1">
                <input type="hidden" name="theme" value="<%= currentTheme === 'light' ? 'dark' : 'light' %>" />
                <input type="hidden" name="next" value="<%= currentPath || '/' %>" />
                <button type="submit" class="btn btn-outline-light btn-sm d-flex align-items-center theme-toggle-btn">
                  <% if (currentTheme === 'light') { %>🌙<% } else { %>☀️<% } %>
                </button>
              </form>

              <div class="dropdown">
                <button
                  class="btn btn-outline-light btn-sm d-flex align-items-center gap-2"
                  type="button"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  style="border-radius: 999px;"
                >
                  <% if (currentUser.profilePhotoUrl) { %>
                    <img
                      src="<%= currentUser.profilePhotoUrl %>"
                      alt="Profile"
                      style="width: 22px; height: 22px; border-radius: 999px; object-fit: cover;"
                    />
                  <% } else { %>
                    <span class="avatar-circle" style="margin-right: 0;">
                      <%= currentUser.displayName
                        ? currentUser.displayName.charAt(0).toUpperCase()
                        : (currentUser.email || '?').charAt(0).toUpperCase() %>
                    </span>
                  <% } %>

                  <span style="font-size: 0.85rem;">
                    <%= currentUser.displayName || currentUser.email %>
                  </span>

                  <span style="opacity: 0.8;">▾</span>
                </button>

                <ul class="dropdown-menu dropdown-menu-end">
                  <li><a class="dropdown-item" href="/workouts/streak">Streak</a></li>
                  <li><a class="dropdown-item" href="/workouts/stats">Stats</a></li>
                  <li><a class="dropdown-item" href="/workouts/library">Library</a></li>
                  <li><a class="dropdown-item" href="/insights">Insights</a></li>
                  <li><a class="dropdown-item" href="/account/settings">Settings</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li>
                    <form action="/auth/logout" method="POST" style="margin: 0;">
                      <button class="dropdown-item text-danger" type="submit">Log out</button>
                    </form>
                  </li>
                </ul>
              </div>
            </div>
          <% } else { %>
            <div class="ms-auto d-flex align-items-center gap-2">
              <a href="/auth/login" class="btn btn-outline-light btn-sm">Log In</a>
              <a href="/auth/register" class="btn btn-primary btn-sm ms-1">Sign Up</a>
            </div>
          <% } %>
        </div>
      </div>
    </nav>

    <main class="main-shell mb-5">