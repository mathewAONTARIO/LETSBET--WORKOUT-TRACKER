<%- include('../partials/header', { currentPath: '/exercises' }) %>

<div class="main-shell">
  <h1 class="mb-3">Add Exercise</h1>

  <form method="POST" action="/exercises/new" class="glass-card p-3">
    <label class="form-label">Name</label>
    <input class="form-control mb-3" name="name" required placeholder="Bench Press" />

    <label class="form-label">Category</label>
    <select class="form-select mb-3" name="category">
      <option>Push</option><option>Pull</option><option>Legs</option><option>Upper Body</option>
      <option>Lower Body</option><option>Core</option><option>Cardio</option><option>Full Body</option>
      <option selected>Other</option>
    </select>

    <label class="form-label">Muscles (comma separated)</label>
    <input class="form-control mb-3" name="muscles" placeholder="Chest, Triceps, Shoulders" />

    <label class="form-label">Instructions (one step per line)</label>
    <textarea class="form-control mb-3" name="instructions" rows="6"></textarea>

    <label class="form-label">Tips (one per line)</label>
    <textarea class="form-control mb-3" name="tips" rows="4"></textarea>

    <label class="form-label">Image URL (optional)</label>
    <input class="form-control mb-2" name="imageUrl" placeholder="https://.../bench.jpg (leave blank for auto)" />

    <div class="form-check mb-3">
      <input class="form-check-input" type="checkbox" name="autoImage" id="autoImage" checked />
      <label class="form-check-label" for="autoImage">
        Auto-find an image online and save it locally
      </label>
      <div class="text-secondary" style="font-size:.85rem;margin-top:4px;">
        Downloads into <code>/public/img/exercises</code> and stores <code>/img/exercises/...</code>
      </div>
    </div>

    <label class="form-label">Video URL (optional)</label>
    <input class="form-control mb-3" name="videoUrl" placeholder="https://youtube.com/..." />

    <label class="form-label">Equipment (comma separated)</label>
    <input class="form-control mb-3" name="equipment" placeholder="Barbell, Bench" />

    <label class="form-label">Difficulty</label>
    <select class="form-select mb-3" name="difficulty">
      <option selected>Beginner</option>
      <option>Intermediate</option>
      <option>Advanced</option>
    </select>

    <div class="d-flex gap-2">
      <button class="btn btn-primary btn-pill" type="submit">Save</button>
      <a class="btn btn-outline-light btn-pill" href="/exercises">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>