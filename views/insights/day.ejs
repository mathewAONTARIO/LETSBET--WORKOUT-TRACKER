<%- include('../partials/header', { title: 'Daily Summary' }) %>

<div class="main-shell">
  <section class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <h1 class="mb-1">Daily Summary</h1>
      <p class="mb-0 text-secondary"><%= dateLabel %></p>
    </div>

    <div class="d-flex gap-2">
      <a class="btn btn-outline-light" href="/week">This Week</a>
      <a class="btn btn-outline-light" href="/workouts/calendar">Calendar</a>
    </div>
  </section>

  <section class="glass-card p-4 mb-4">
    <div class="row g-3">
      <div class="col-md-3">
        <div class="text-secondary">Workouts</div>
        <div class="fs-4 fw-semibold"><%= totalWorkouts %></div>
      </div>
      <div class="col-md-3">
        <div class="text-secondary">Meals</div>
        <div class="fs-4 fw-semibold"><%= totalMeals %></div>
      </div>
      <div class="col-md-3">
        <div class="text-secondary">Calories</div>
        <div class="fs-4 fw-semibold"><%= totals.calories %> kcal</div>
      </div>
      <div class="col-md-3">
        <div class="text-secondary">Protein</div>
        <div class="fs-4 fw-semibold"><%= totals.protein %> g</div>
      </div>
    </div>

    <div class="mt-3 text-secondary">
      C: <%= totals.carbs %>g · F: <%= totals.fats %>g
      <% if (totalVolume > 0) { %> · Volume: <%= Math.round(totalVolume) %> <% } %>
    </div>
  </section>

  <div class="row g-4">
    <div class="col-lg-6">
      <section class="glass-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h3 class="mb-0">Workouts</h3>
          <a class="btn btn-sm btn-primary btn-pill" href="/workouts/new">Add</a>
        </div>

        <% if (!workouts || workouts.length === 0) { %>
          <p class="mb-0 text-secondary">No workouts logged for this day.</p>
        <% } else { %>
          <% workouts.forEach(w => { %>
            <div class="workout-card mt-3">
              <div class="workout-main">
                <div class="workout-title">
                  <%= w.exercise %>
                  <% if (w.isPR) { %><span class="badge-pr">PR</span><% } %>
                </div>
                <div class="workout-meta">
                  <%= w.sets %> × <%= w.reps %>
                  <% if (w.weight) { %> · <%= w.weight %> kg <% } %>
                  <% if (w.notes) { %> · <%= w.notes %> <% } %>
                </div>
              </div>
              <span class="badge-category badge-<%= (w.category || 'other').toLowerCase() %>">
                <%= w.category || 'Other' %>
              </span>
            </div>
          <% }) %>
        <% } %>
      </section>
    </div>

    <div class="col-lg-6">
      <section class="glass-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h3 class="mb-0">Meals</h3>
          <a class="btn btn-sm btn-primary btn-pill" href="/meals/new">Add</a>
        </div>

        <% if (!meals || meals.length === 0) { %>
          <p class="mb-0 text-secondary">No meals logged for this day.</p>
        <% } else { %>
          <div class="d-flex flex-column gap-2 mt-3">
            <% meals.forEach(m => { %>
              <div class="glass-card p-3">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <div class="fw-semibold text-capitalize"><%= m.name %></div>
                    <div class="text-secondary">
                      <%= m.timeOfDay || '—' %> · <%= Number(m.calories) || 0 %> kcal
                    </div>
                    <div class="text-secondary">
                      P: <%= m.protein || 0 %>g · C: <%= m.carbs || 0 %>g · F: <%= m.fats || 0 %>g
                    </div>
                  </div>

                  <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-light" href="/meals/<%= m._id %>/edit">Edit</a>
                    <form action="/meals/<%= m._id %>/delete" method="POST">
                      <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>