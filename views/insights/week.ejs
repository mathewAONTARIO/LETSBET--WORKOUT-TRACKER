<%- include('../partials/header', { title: 'Weekly Overview' }) %>

<div class="main-shell">
  <section class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <h1 class="mb-1">Weekly Overview</h1>
      <p class="mb-0 text-secondary"><%= weekStart %> → <%= weekEnd %></p>
    </div>

    <div class="d-flex gap-2">
      <a class="btn btn-outline-light" href="/day/<%= weekStart %>">Open Monday</a>
      <a class="btn btn-outline-light" href="/workouts">Workouts</a>
      <a class="btn btn-outline-light" href="/meals">Meals</a>
    </div>
  </section>

  <section class="glass-card p-4">
    <div class="row g-3">
      <div class="col-md-3">
        <div class="text-secondary">Workouts</div>
        <div class="fs-4 fw-semibold"><%= totalWorkouts %></div>
      </div>

      <div class="col-md-3">
        <div class="text-secondary">Total Calories</div>
        <div class="fs-4 fw-semibold"><%= totals.calories %></div>
      </div>

      <div class="col-md-3">
        <div class="text-secondary">Avg Calories / day</div>
        <div class="fs-4 fw-semibold"><%= Math.round(avgCalories) %></div>
      </div>

      <div class="col-md-3">
        <div class="text-secondary">Avg Protein / day</div>
        <div class="fs-4 fw-semibold"><%= Math.round(avgProtein) %> g</div>
      </div>
    </div>

    <div class="mt-3 text-secondary">
      Week totals — P: <%= totals.protein %>g · C: <%= totals.carbs %>g · F: <%= totals.fats %>g
      · Days with meals: <%= mealDaysCount %>/7
    </div>
  </section>
</div>

<%- include('../partials/footer') %>