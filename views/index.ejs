<%- include('./partials/header', { currentPath: '/' }) %>

<section class="hero text-center mb-5">
  <% if (currentUser) { %>
    <p class="text-secondary mb-2" style="font-size:0.9rem;">
      Welcome back, <%= currentUser.displayName %>.
    </p>
  <% } %>

  <h1 class="display-4 fw-bold mb-3">Lets Bet – Keep Going</h1>
  <p class="lead mb-4">Track your workouts, stay consistent, and keep betting on yourself.</p>
  <div class="d-flex justify-content-center gap-3">
    <a href="/workouts" class="btn btn-primary btn-lg">See Workouts</a>
    <a href="/workouts/new" class="btn btn-outline-light btn-lg">Add a Workout</a>
  </div>
</section>

<section class="home-stats mb-5">
  <div class="row g-4">
    <div class="col-md-3">
      <div class="glass-card p-4">
        <p class="text-secondary text-uppercase small mb-2">This Week</p>
        <p class="stat-value h4 mb-0"><%= weeklyWorkouts %> Workouts</p>
      </div>
    </div>

    <div class="col-md-3">
      <div class="glass-card p-4">
        <p class="text-secondary text-uppercase small mb-2">Weekly Volume</p>
        <p class="stat-value h4 mb-0"><%= weeklyVolume %></p>
      </div>
    </div>

    <div class="col-md-3">
      <div class="glass-card p-4">
        <p class="text-secondary text-uppercase small mb-2">Best Day</p>
        <p class="stat-value h4 mb-0"><%= bestDay || '—' %></p>
      </div>
    </div>

    <div class="col-md-3">
      <div class="glass-card p-4">
        <p class="text-secondary text-uppercase small mb-2">Weekly Goal</p>
        <div class="progress" style="height: 8px;">
          <div
            class="progress-bar bg-primary"
            role="progressbar"
            style="width: <%= weeklyProgressPercent || 0 %>%">
          </div>
        </div>
        <p class="stat-value h6 mt-2 mb-0">
          <%= weeklyWorkouts %> / <%= weeklyGoal %> this week
        </p>
      </div>
    </div>
  </div>
</section>

<section class="mb-5">
  <div class="glass-card p-4">
    <p class="text-secondary text-uppercase small mb-2">Workout of the Day</p>
    <% if (workoutOfDay) { %>
      <h5 class="mb-1"><%= workoutOfDay.exercise %></h5>
      <p class="mb-0">
        <%= workoutOfDay.sets %> × <%= workoutOfDay.reps %>
        <% if (workoutOfDay.weight) { %> · <%= workoutOfDay.weight %> kg <% } %>
      </p>
    <% } else { %>
      <p class="mb-0 text-secondary">Log a workout to see it here.</p>
    <% } %>
  </div>
</section>

<%- include('./partials/footer') %>