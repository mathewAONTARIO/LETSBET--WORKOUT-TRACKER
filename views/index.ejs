<%- include('partials/header', { currentPath: '/' }) %>

<section class="hero text-center mb-5">
  <p class="text-secondary mb-2" style="font-size:0.9rem;">
    Welcome back, <%= typeof profileName !== 'undefined' ? profileName : 'Mathew' %>.
  </p>
  <h1 class="display-4 fw-bold mb-3">Lets Bet – Keep Going</h1>
  <p class="lead mb-4">
    Track your workouts, stay consistent, and keep betting on yourself.
  </p>
  <a href="/workouts" class="btn btn-lg btn-primary me-2">See Workouts</a>
  <a href="/workouts/new" class="btn btn-lg btn-outline-light">Add a Workout</a>
</section>

<section class="mb-4">
  <div class="row g-3">
    <div class="col-md-3">
      <div class="glass-card h-100">
        <div class="card-body p-3">
          <h6 class="text-uppercase text-secondary mb-2" style="font-size:0.8rem;">This Week</h6>
          <p class="h4 mb-0">
            <%= typeof weeklyWorkouts !== 'undefined' ? weeklyWorkouts : 0 %> Workouts
          </p>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="glass-card h-100">
        <div class="card-body p-3">
          <h6 class="text-uppercase text-secondary mb-2" style="font-size:0.8rem;">Weekly Volume</h6>
          <p class="h4 mb-0">
            <%= typeof weeklyVolume !== 'undefined' ? weeklyVolume : 0 %>
          </p>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="glass-card h-100">
        <div class="card-body p-3">
          <h6 class="text-uppercase text-secondary mb-2" style="font-size:0.8rem;">Best Day</h6>
          <p class="h4 mb-0">
            <%= typeof bestDay !== 'undefined' && bestDay ? bestDay : '—' %>
          </p>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="glass-card h-100">
        <div class="card-body p-3">
          <h6 class="text-uppercase text-secondary mb-2" style="font-size:0.8rem;">Weekly Goal</h6>
          <div class="progress" style="height:6px;border-radius:999px;background:#020617;">
            <div
              class="progress-bar"
              role="progressbar"
              style="width:<%= typeof goalPercent !== 'undefined' ? goalPercent : 0 %>%"
              aria-valuenow="<%= typeof goalPercent !== 'undefined' ? goalPercent : 0 %>"
              aria-valuemin="0"
              aria-valuemax="100"
            ></div>
          </div>
          <p class="mt-2 mb-0" style="font-size:0.85rem;">
            <%= typeof weeklyProgress !== 'undefined' ? weeklyProgress : 0 %> /
            <%= typeof weeklyGoal !== 'undefined' ? weeklyGoal : 4 %> this week
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="mb-4">
  <div class="glass-card">
    <div class="card-body p-3">
      <h6 class="text-uppercase text-secondary mb-2" style="font-size:0.8rem;">Workout of the Day</h6>
      <% if (typeof workoutOfDay !== 'undefined' && workoutOfDay) { %>
        <p class="mb-1"><strong><%= workoutOfDay.exercise %></strong></p>
        <p class="text-secondary mb-0" style="font-size:0.9rem;">
          <%= workoutOfDay.sets %> × <%= workoutOfDay.reps %>
          <% if (workoutOfDay.weight) { %> · <%= workoutOfDay.weight %> kg <% } %>
        </p>
      <% } else { %>
        <p class="text-secondary mb-0" style="font-size:0.9rem;">
          Log a workout to see it here.
        </p>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>