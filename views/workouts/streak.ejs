<%- include('../partials/header', { currentPath: '/workouts/streak' }) %>

<h2 class="mb-1">Your Workouts</h2>
<p class="text-secondary mb-4">Log your sessions and keep track of what you've done.</p>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="glass-card text-light h-100">
      <div class="card-body p-3">
        <h6 class="text-uppercase text-secondary mb-2" style="font-size: 0.8rem;">Current Streak</h6>
        <p class="display-6 fw-bold mb-0"><%= currentStreak %> Days</p>
        <div class="streak-bar-wrapper">
          <div class="streak-bar">
            <% const maxStreak = Math.max(longestStreak || 1, 1); %>
            <div class="streak-bar-fill" style="width:<%= Math.min(100, (currentStreak / maxStreak) * 100) %>%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="glass-card text-light h-100">
      <div class="card-body p-3">
        <h6 class="text-uppercase text-secondary mb-2" style="font-size: 0.8rem;">Best Streak</h6>
        <p class="display-6 fw-bold mb-0"><%= longestStreak %> Days</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="glass-card text-light h-100">
      <div class="card-body p-3">
        <h6 class="text-uppercase text-secondary mb-2" style="font-size: 0.8rem;">Days Logged</h6>
        <p class="display-6 fw-bold mb-0"><%= totalDays %></p>
      </div>
    </div>
  </div>
</div>

<% if (lastWorkoutDate) { %>
  <p class="text-secondary mb-4">Last workout logged: <%= lastWorkoutDate %></p>
<% } else { %>
  <p class="text-secondary mb-4">No workouts logged yet. Start today.</p>
<% } %>

<a href="/workouts/new" class="btn btn-primary me-2">Add Workout</a>
<a href="/workouts" class="btn btn-outline-light">View All</a>

<%- include('../partials/footer') %>