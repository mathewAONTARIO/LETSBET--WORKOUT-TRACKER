<%- include('../partials/header', { currentPath: '/workouts' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="mb-1">Your Workouts</h2>
    <p class="text-secondary mb-0" style="font-size: 0.9rem;">Review what you've logged and keep stacking reps.</p>
  </div>
  <a href="/workouts/new" class="btn btn-primary">Add New Exercise</a>
</div>

<form class="row g-2 mb-3" method="GET" action="/workouts">
  <div class="col-md-4">
    <input
      type="text"
      name="q"
      class="form-control"
      placeholder="Search by exercise..."
      value="<%= filters.q %>">
  </div>
  <div class="col-md-4">
    <select name="category" class="form-select">
      <% const cats = ['All','Push','Pull','Legs','Upper Body','Lower Body','Cardio','Core','Full Body','Other']; %>
      <% cats.forEach(c => { %>
        <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-md-3">
    <input
      type="date"
      name="date"
      class="form-control"
      value="<%= filters.date %>">
  </div>
  <div class="col-md-1 d-grid">
    <button class="btn btn-outline-light" type="submit">Go</button>
  </div>
</form>

<% if (workouts.length === 0) { %>
  <p class="text-secondary">
    No workouts match that. <a href="/workouts/new">Add a new one.</a>
  </p>
<% } else { %>
  <div class="mt-3">
    <% workouts.forEach(workout => { %>
      <div class="workout-card">
        <div class="workout-main">
          <div class="workout-title"><%= workout.exercise %></div>
          <div class="workout-meta">
            <span><%= workout.sets %> × <%= workout.reps %></span>
            <% if (workout.weight) { %>
              · <span><%= workout.weight %> kg</span>
            <% } %>
          </div>
        </div>
        <div class="text-end">
          <div class="mb-1">
            <% const cat = (workout.category || 'Other'); %>
            <% const key = cat.toLowerCase().replace(' ','-'); %>
            <span class="badge-category badge-<%= key %>"><%= cat %></span>
            <% if (workout.weight) { 
                 const exKey = workout.exercise.toLowerCase();
                 if (prsByExercise && prsByExercise[exKey] === workout.weight) { %>
              <span class="badge-pr">PR</span>
            <% } } %>
          </div>
          <div class="badge-date mb-2">
            <%= workout.date.toISOString().slice(0,10) %>
          </div>
          <div class="d-flex justify-content-end gap-1">
            <a href="/workouts/<%= workout._id %>/edit" class="btn btn-sm btn-outline-light">Edit</a>
            <form action="/workouts/<%= workout._id %>/duplicate" method="POST">
              <button type="submit" class="btn btn-sm btn-outline-light">Duplicate</button>
            </form>
            <a href="/workouts/<%= workout._id %>/delete" class="btn btn-sm btn-outline-danger">Delete</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>