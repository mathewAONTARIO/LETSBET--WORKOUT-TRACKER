<%- include('../partials/header', { currentPath: '/workouts' }) %>

<h2 class="mb-1">Workouts</h2>
<p class="text-secondary mb-4">All workouts logged for your account.</p>

<% if (!workouts || workouts.length === 0) { %>
  <div class="glass-card p-3 mb-3">
    <p class="mb-0 text-secondary">No workouts yet. Add your first one!</p>
  </div>
<% } else { %>
  <% workouts.forEach(w => { %>
    <div class="workout-card">
      <div class="workout-main">
        <div class="workout-title"><%= w.exercise %></div>
        <div class="workout-meta">
          <%= w.category || 'Workout' %> ·
          <%= w.sets %> x <%= w.reps %>
          <% if (w.weight) { %> · <%= w.weight %> kg <% } %>
          · <%= new Date(w.date).toLocaleDateString() %>
        </div>
      </div>
      <div class="d-flex gap-2">
        <form action="/workouts/<%= w._id %>/duplicate" method="POST">
          <button class="btn btn-sm btn-outline-light" type="submit">Duplicate</button>
        </form>
        <a href="/workouts/<%= w._id %>/edit" class="btn btn-sm btn-outline-light">Edit</a>
      </div>
    </div>
  <% }) %>
<% } %>

<a href="/workouts/new" class="btn btn-primary mt-3">Add Workout</a>

<%- include('../partials/footer') %>