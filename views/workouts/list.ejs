<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Workouts – LetsBetFit</title>
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body class="page-body">
  <%- include('../partials/header', { currentPath }) %>

  <main class="page-main">
    <section class="page-section">
      <div class="section-header">
        <div>
          <h1 class="section-title">Workouts</h1>
          <p class="section-subtitle">Log your training sessions and track your progress.</p>
        </div>
        <a href="/workouts/new" class="btn btn-primary">Add Workout</a>
      </div>

      <% if (!workouts || workouts.length === 0) { %>
        <div class="card empty-card">
          <p>You haven’t logged any workouts yet.</p>
          <a href="/workouts/new" class="btn btn-primary">Log your first workout</a>
        </div>
      <% } else { %>
        <div class="card table-card">
          <table class="data-table">
            <thead>
              <tr>
                <th>Exercise</th>
                <th>Category</th>
                <th>Sets</th>
                <th>Reps</th>
                <th>Weight</th>
                <th>Date</th>
                <th>PR</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% workouts.forEach(function(w) { %>
                <tr>
                  <td><strong><%= w.exercise %></strong></td>
                  <td><%= w.category || '—' %></td>
                  <td><%= w.sets || '—' %></td>
                  <td><%= w.reps || '—' %></td>
                  <td><%= w.weight ? w.weight + ' lb' : '—' %></td>
                  <td>
                    <% if (w.date) { %>
                      <%= new Date(w.date).toLocaleDateString() %>
                    <% } else { %>
                      —
                    <% } %>
                  </td>
                  <td><%= w.isPR ? '🏆' : '' %></td>
                  <td class="table-actions">
                    <form action="/workouts/<%= w._id %>/duplicate" method="POST" class="inline-form">
                      <button type="submit" class="btn btn-ghost">Duplicate</button>
                    </form>
                    <a href="/workouts/<%= w._id %>/edit" class="btn btn-ghost">Edit</a>
                    <a href="/workouts/<%= w._id %>/delete" class="btn btn-danger-outline">Delete</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>