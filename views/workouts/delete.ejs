<%- include('../partials/header', { currentPath: '/workouts/delete' }) %>

<h2 class="mb-3">Delete Workout</h2>

<div class="glass-card p-4 mb-3">
  <p class="mb-3">Are you sure you want to delete this workout?</p>
  <p class="mb-1"><strong><%= workout.exercise %></strong></p>
  <p class="text-secondary mb-0" style="font-size:0.9rem;">
    <%= workout.sets %> × <%= workout.reps %>
    <% if (workout.weight) { %> · <%= workout.weight %> kg <% } %>
    · <%= workout.date.toISOString().slice(0,10) %>
  </p>
</div>

<form action="/workouts/<%= workout._id %>/delete" method="POST">
  <button type="submit" class="btn btn-danger me-2">Delete</button>
  <a href="/workouts" class="btn btn-outline-light">Cancel</a>
</form>

<%- include('../partials/footer') %>