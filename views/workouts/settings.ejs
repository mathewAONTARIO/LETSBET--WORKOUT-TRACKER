<%- include('../partials/header', { currentPath: '/workouts/settings' }) %>

<div class="row justify-content-center mb-4">
  <div class="col-lg-10">
    <h1 class="mb-1">Settings</h1>
    <p class="text-secondary mb-4">Customize your Lets Bet experience.</p>
  </div>
</div>

<div class="row justify-content-center g-4">
  <!-- Profile -->
  <div class="col-lg-5 col-md-6">
    <div class="glass-card p-4 h-100">
      <h2 class="h5 mb-3">Profile</h2>

      <form action="/account" method="POST">
        <!-- (Optional) profile picture upload UI only for now -->
        <div class="d-flex align-items-center mb-3">
          <div class="avatar-circle me-2">
            <%= (user && (user.displayName || user.email || '?').charAt(0).toUpperCase()) %>
          </div>
          <div>
            <label class="form-label mb-1">Profile picture</label>
            <div class="d-flex gap-2">
              <input type="file" class="form-control form-control-sm" disabled />
              <button type="button" class="btn btn-outline-light btn-sm" disabled>Upload</button>
            </div>
            <small class="text-secondary">Coming soon.</small>
          </div>
        </div>

        <!-- Display name -->
        <div class="mb-3">
          <label class="form-label">Display name</label>
          <input
            type="text"
            name="displayName"
            class="form-control"
            value="<%= user && user.displayName ? user.displayName : '' %>">
        </div>

        <!-- Weekly goal -->
        <div class="mb-3">
          <label class="form-label">Weekly workout goal</label>
          <select name="weeklyGoal" class="form-select">
            <% const wg = (user && user.weeklyGoal) || 4; %>
            <option value="3" <%= wg === 3 ? 'selected' : '' %>>3 per week</option>
            <option value="4" <%= wg === 4 ? 'selected' : '' %>>4 per week</option>
            <option value="5" <%= wg === 5 ? 'selected' : '' %>>5 per week</option>
            <option value="6" <%= wg === 6 ? 'selected' : '' %>>6 per week</option>
            <option value="7" <%= wg === 7 ? 'selected' : '' %>>7 per week</option>
          </select>
        </div>

        <div class="row">
          <!-- Gender -->
          <div class="col-md-6 mb-3">
            <label class="form-label">Gender</label>
            <% const gender = (user && user.gender) || 'prefer-not'; %>
            <select name="gender" class="form-select">
              <option value="prefer-not" <%= gender === 'prefer-not' || gender === '' ? 'selected' : '' %>>Prefer not to say</option>
              <option value="male" <%= gender === 'male' ? 'selected' : '' %>>Male</option>
              <option value="female" <%= gender === 'female' ? 'selected' : '' %>>Female</option>
              <option value="non-binary" <%= gender === 'non-binary' ? 'selected' : '' %>>Non-binary</option>
            </select>
          </div>

          <!-- Age -->
          <div class="col-md-6 mb-3">
            <label class="form-label">Age</label>
            <input
              type="number"
              name="age"
              min="0"
              max="120"
              class="form-control"
              value="<%= user && user.age != null ? user.age : '' %>">
          </div>
        </div>

        <div class="row">
          <!-- Height + unit -->
          <div class="col-md-6 mb-3">
            <label class="form-label">Height</label>
            <div class="input-group">
              <input
                type="number"
                step="0.1"
                name="heightValue"
                class="form-control"
                placeholder="e.g. 180"
                value="<%= user && user.heightValue != null ? user.heightValue : '' %>">
              <% const hUnit = (user && user.heightUnit) || 'cm'; %>
              <select name="heightUnit" class="form-select" style="max-width: 90px;">
                <option value="cm" <%= hUnit === 'cm' ? 'selected' : '' %>>cm</option>
                <option value="ft" <%= hUnit === 'ft' ? 'selected' : '' %>>ft</option>
              </select>
            </div>
          </div>

          <!-- Weight + unit -->
          <div class="col-md-6 mb-3">
            <label class="form-label">Weight</label>
            <div class="input-group">
              <input
                type="number"
                step="0.1"
                name="weightValue"
                class="form-control"
                placeholder="e.g. 80"
                value="<%= user && user.weightValue != null ? user.weightValue : '' %>">
              <% const wUnit = (user && user.weightUnit) || 'kg'; %>
              <select name="weightUnit" class="form-select" style="max-width: 90px;">
                <option value="kg" <%= wUnit === 'kg' ? 'selected' : '' %>>kg</option>
                <option value="lb" <%= wUnit === 'lb' ? 'selected' : '' %>>lb</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Goals -->
        <div class="mb-3">
          <label class="form-label">Primary goal</label>
          <% const pGoal = (user && user.primaryGoal) || 'general'; %>
          <select name="primaryGoal" class="form-select">
            <option value="general" <%= pGoal === 'general' ? 'selected' : '' %>>General fitness</option>
            <option value="strength" <%= pGoal === 'strength' ? 'selected' : '' %>>Strength & muscle</option>
            <option value="fat-loss" <%= pGoal === 'fat-loss' ? 'selected' : '' %>>Fat loss</option>
            <option value="performance" <%= pGoal === 'performance' ? 'selected' : '' %>>Sports performance</option>
          </select>
        </div>

        <div class="mb-4">
          <label class="form-label">Training experience</label>
          <% const tExp = (user && user.trainingExperience) || 'beginner'; %>
          <select name="trainingExperience" class="form-select">
            <option value="beginner" <%= tExp === 'beginner' ? 'selected' : '' %>>Beginner (0–6 months)</option>
            <option value="intermediate" <%= tExp === 'intermediate' ? 'selected' : '' %>>Intermediate (6–24 months)</option>
            <option value="advanced" <%= tExp === 'advanced' ? 'selected' : '' %>>Advanced (2+ years)</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary w-100">
          Save profile
        </button>
      </form>
    </div>
  </div>

  <!-- Appearance + Reminders -->
  <div class="col-lg-5 col-md-6">
    <!-- Appearance -->
    <div class="glass-card p-4 mb-4">
      <h2 class="h5 mb-3">Appearance</h2>
      <p class="text-secondary mb-3">Choose between dark and light mode.</p>

      <form action="/account/theme" method="POST" class="mb-2">
        <% const theme = currentTheme || 'dark'; %>
        <div class="form-check mb-2">
          <input
            class="form-check-input"
            type="radio"
            name="theme"
            id="themeDark"
            value="dark"
            <%= theme !== 'light' ? 'checked' : '' %>>
          <label class="form-check-label" for="themeDark">
            Dark mode (recommended)
          </label>
        </div>
        <div class="form-check mb-3">
          <input
            class="form-check-input"
            type="radio"
            name="theme"
            id="themeLight"
            value="light"
            <%= theme === 'light' ? 'checked' : '' %>>
          <label class="form-check-label" for="themeLight">
            Light mode
          </label>
        </div>
        <button type="submit" class="btn btn-outline-light btn-sm">
          Save appearance
        </button>
      </form>
    </div>

    <!-- Workout reminders -->
    <div class="glass-card p-4 mb-4">
      <h2 class="h5 mb-3">Workout reminders</h2>
      <p class="text-secondary mb-3">
        Set a daily reminder time to log your workouts. (Future versions could send real notifications.)
      </p>

      <form action="/account/reminders" method="POST">
        <% const reminderEnabled = user && user.reminderEnabled; %>
        <% const reminderTime = (user && user.reminderTime) || '18:00'; %>

        <div class="form-check form-switch mb-3">
          <input
            class="form-check-input"
            type="checkbox"
            id="reminderEnabled"
            name="reminderEnabled"
            <%= reminderEnabled ? 'checked' : '' %>>
          <label class="form-check-label" for="reminderEnabled">
            Enable daily reminder
          </label>
        </div>

        <div class="mb-3">
          <label class="form-label">Reminder time</label>
          <input
            type="time"
            name="reminderTime"
            class="form-control"
            value="<%= reminderTime %>">
          <small class="text-secondary">
            This just stores your preferred time for now.
          </small>
        </div>

        <button type="submit" class="btn btn-primary w-100">
          Save reminder settings
        </button>
      </form>
    </div>
  </div>
</div>

<!-- Danger zone -->
<div class="row justify-content-center mt-3 mb-5">
  <div class="col-lg-10">
    <div class="glass-card p-4 border-danger" style="border-width: 1px;">
      <h2 class="h5 text-danger mb-2">Danger zone</h2>
      <p class="text-secondary mb-3">
        Deleting your account will remove all workouts and data linked to this login. This cannot be undone.
      </p>
      <form action="/account/delete" method="POST" onsubmit="return confirm('Delete your account and all workouts? This cannot be undone.');">
        <button type="submit" class="btn btn-outline-danger">
          Delete my account
        </button>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>