<%- include('../partials/header', { currentPath: '/workouts/settings' }) %>

<section class="mb-4">
  <h1 class="mb-2">Settings</h1>
  <p class="text-secondary mb-4">Customize your Lets Bet experience.</p>

  <div class="row g-4">
    <!-- PROFILE -->
    <div class="col-md-6">
      <div class="glass-card p-4 mb-4">
        <h5 class="mb-3">Profile</h5>

        <!-- Avatar (non-functional backend for now, but UI is ready) -->
        <div class="d-flex align-items-center mb-3">
          <div class="avatar-circle me-3" style="width:40px;height:40px;font-size:1rem;">
            <%= (user.displayName || user.email || '?').charAt(0).toUpperCase() %>
          </div>
          <div>
            <div class="small text-secondary">Profile picture</div>
            <form action="/account/photo" method="POST" enctype="multipart/form-data" class="d-flex align-items-center gap-2 mt-1">
              <input type="file" name="photo" accept="image/png,image/jpeg" class="form-control form-control-sm" style="max-width:220px;" />
              <button class="btn btn-outline-light btn-sm" type="submit">Upload</button>
            </form>
          </div>
        </div>

        <!-- Main profile form -->
        <form action="/account/profile" method="POST" class="mt-3">
          <div class="mb-3">
            <label class="form-label">Display name</label>
            <input
              type="text"
              name="displayName"
              class="form-control"
              value="<%= user.displayName || '' %>"
            />
          </div>

          <div class="mb-3">
            <label class="form-label">Weekly workout goal</label>
            <select name="weeklyGoal" class="form-select">
              <% const goal = user.weeklyGoal || 4; %>
              <% for (let i = 1; i <= 14; i++) { %>
                <option value="<%= i %>" <%= goal === i ? 'selected' : '' %>><%= i %> per week</option>
              <% } %>
            </select>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Gender</label>
              <select name="gender" class="form-select">
                <option value="prefer_not_to_say" <%= user.gender === 'prefer_not_to_say' ? 'selected' : '' %>>Prefer not to say</option>
                <option value="male" <%= user.gender === 'male' ? 'selected' : '' %>>Male</option>
                <option value="female" <%= user.gender === 'female' ? 'selected' : '' %>>Female</option>
                <option value="other" <%= user.gender === 'other' ? 'selected' : '' %>>Other</option>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Age</label>
              <input
                type="number"
                min="10"
                max="100"
                name="age"
                class="form-control"
                value="<%= user.age || '' %>"
              />
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Height (cm)</label>
              <input
                type="number"
                step="0.5"
                min="100"
                max="250"
                name="heightCm"
                class="form-control"
                value="<%= user.heightCm || '' %>"
              />
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label">Weight</label>
              <div class="input-group">
                <% 
                  const weightUnit = user.preferredWeightUnit || 'kg';
                  let weightDisplay = '';
                  if (user.weightKg) {
                    if (weightUnit === 'lb') {
                      weightDisplay = (user.weightKg * 2.20462).toFixed(1);
                    } else {
                      weightDisplay = user.weightKg.toFixed(1);
                    }
                  }
                %>
                <input
                  id="weightValue"
                  type="number"
                  step="0.1"
                  min="20"
                  max="400"
                  name="weightValue"
                  class="form-control"
                  value="<%= weightDisplay %>"
                />
                <select id="weightUnit" name="weightUnit" class="form-select" style="max-width:90px;">
                  <option value="kg" <%= weightUnit === 'kg' ? 'selected' : '' %>>kg</option>
                  <option value="lb" <%= weightUnit === 'lb' ? 'selected' : '' %>>lb</option>
                </select>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Primary goal</label>
              <select name="primaryGoal" class="form-select">
                <% const goalType = user.primaryGoal || 'general_fitness'; %>
                <option value="general_fitness" <%= goalType === 'general_fitness' ? 'selected' : '' %>>General fitness</option>
                <option value="strength" <%= goalType === 'strength' ? 'selected' : '' %>>Build strength</option>
                <option value="muscle_gain" <%= goalType === 'muscle_gain' ? 'selected' : '' %>>Build muscle</option>
                <option value="fat_loss" <%= goalType === 'fat_loss' ? 'selected' : '' %>>Lose fat / weight</option>
                <option value="performance" <%= goalType === 'performance' ? 'selected' : '' %>>Sports performance</option>
                <option value="other" <%= goalType === 'other' ? 'selected' : '' %>>Other</option>
              </select>
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label">Training experience</label>
              <select name="trainingExperience" class="form-select">
                <% const level = user.trainingExperience || 'beginner'; %>
                <option value="beginner" <%= level === 'beginner' ? 'selected' : '' %>>Beginner (0–6 months)</option>
                <option value="intermediate" <%= level === 'intermediate' ? 'selected' : '' %>>Intermediate (6–24 months)</option>
                <option value="advanced" <%= level === 'advanced' ? 'selected' : '' %>>Advanced (2+ years)</option>
              </select>
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-100 mt-2">Save profile</button>
        </form>
      </div>
    </div>

    <!-- APPEARANCE + REMINDERS -->
    <div class="col-md-6">
      <!-- Appearance -->
      <div class="glass-card p-4 mb-4">
        <h5 class="mb-3">Appearance</h5>
        <p class="text-secondary small mb-3">Choose between dark and light mode.</p>

        <form action="/account/theme" method="POST">
          <div class="mb-3">
            <div class="form-check">
              <input
                class="form-check-input"
                type="radio"
                name="theme"
                id="themeDark"
                value="dark"
                <%= user.theme !== 'light' ? 'checked' : '' %>
              />
              <label class="form-check-label" for="themeDark">
                Dark mode (recommended)
              </label>
            </div>

            <div class="form-check mt-2">
              <input
                class="form-check-input"
                type="radio"
                name="theme"
                id="themeLight"
                value="light"
                <%= user.theme === 'light' ? 'checked' : '' %>
              />
              <label class="form-check-label" for="themeLight">
                Light mode
              </label>
            </div>
          </div>

          <button type="submit" class="btn btn-outline-light btn-sm">Save appearance</button>
        </form>
      </div>

      <!-- Workout reminders -->
      <div class="glass-card p-4 mb-4">
        <h5 class="mb-3">Workout reminders</h5>
        <p class="text-secondary small mb-3">
          Set a daily reminder time to log your workouts. (Future versions could send real notifications.)
        </p>

        <form action="/account/reminders" method="POST">
          <div class="form-check form-switch mb-3">
            <input
              class="form-check-input"
              type="checkbox"
              id="reminderEnabled"
              name="reminderEnabled"
              <%= user.reminderEnabled ? 'checked' : '' %>
            />
            <label class="form-check-label" for="reminderEnabled">Enable daily reminder</label>
          </div>

          <div class="mb-3">
            <label class="form-label">Reminder time</label>
            <input
              type="time"
              name="reminderTime"
              class="form-control"
              value="<%= user.reminderTime || '18:00' %>"
            />
            <small class="text-secondary">This just stores your preferred time for now.</small>
          </div>

          <button type="submit" class="btn btn-primary w-100 mt-2">Save reminder settings</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Danger zone -->
  <div class="glass-card p-4 border border-danger mt-2">
    <h5 class="mb-2 text-danger">Danger zone</h5>
    <p class="text-secondary mb-3">
      Deleting your account will remove all workouts and data linked to this login. This cannot be undone.
    </p>

    <form
      action="/account/delete"
      method="POST"
      onsubmit="return confirm('Delete your account and all workouts? This cannot be undone.');"
    >
      <button type="submit" class="btn btn-outline-danger btn-sm">
        Delete my account
      </button>
    </form>
  </div>
</section>

<script>
  // Live convert weight when switching kg <-> lb
  (function () {
    const weightInput = document.getElementById('weightValue');
    const unitSelect = document.getElementById('weightUnit');
    if (!weightInput || !unitSelect) return;

    let lastUnit = unitSelect.value;

    unitSelect.addEventListener('change', () => {
      const v = parseFloat(weightInput.value);
      if (!v || Number.isNaN(v)) {
        lastUnit = unitSelect.value;
        return;
      }

      // kg -> lb
      if (lastUnit === 'kg' && unitSelect.value === 'lb') {
        weightInput.value = (v * 2.20462).toFixed(1);
      }

      // lb -> kg
      if (lastUnit === 'lb' && unitSelect.value === 'kg') {
        weightInput.value = (v / 2.20462).toFixed(1);
      }

      lastUnit = unitSelect.value;
    });
  })();
</script>

<%- include('../partials/footer') %>