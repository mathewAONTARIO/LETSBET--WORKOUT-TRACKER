<%- include('../partials/header', { currentPath: '/workouts/settings' }) %>

<div class="row g-4">
  <!-- Profile card -->
  <div class="col-lg-6">
    <div class="glass-card p-4 h-100">
      <h3 class="mb-3">Profile</h3>
      <p class="text-secondary mb-3">Customize your Lets Bet profile details.</p>

      <!-- Avatar (placeholder) -->
      <form action="/account/avatar" method="POST" enctype="multipart/form-data" class="mb-3 d-flex align-items-center gap-2">
        <div class="avatar-circle">
          <%= (user && (user.displayName || user.email) ? (user.displayName || user.email).charAt(0).toUpperCase() : 'T') %>
        </div>
        <div class="flex-grow-1">
          <label class="form-label mb-1">Profile picture</label>
          <input type="file" name="avatar" class="form-control form-control-sm" accept="image/png,image/jpeg" />
        </div>
        <button class="btn btn-outline-light btn-sm mt-3 mt-md-0" type="submit">Upload</button>
      </form>

      <!-- Main profile form -->
      <form action="/account/profile" method="POST" class="mt-2">
        <div class="mb-3">
          <label class="form-label">Display name</label>
          <input
            type="text"
            name="displayName"
            class="form-control"
            value="<%= user && user.displayName ? user.displayName : (user ? user.email : '') %>"
          />
        </div>

        <div class="mb-3">
          <label class="form-label">Weekly workout goal</label>
          <select name="weeklyGoal" class="form-select">
            <% const currentGoal = (user && user.weeklyGoal) || 4; %>
            <% [2,3,4,5,6,7].forEach(g => { %>
              <option value="<%= g %>" <%= currentGoal === g ? 'selected' : '' %>>
                <%= g %> per week
              </option>
            <% }) %>
          </select>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label">Gender</label>
            <select name="gender" class="form-select">
              <% const gender = (user && user.gender) || 'unspecified'; %>
              <option value="unspecified" <%= gender === 'unspecified' ? 'selected' : '' %>>Prefer not to say</option>
              <option value="male" <%= gender === 'male' ? 'selected' : '' %>>Male</option>
              <option value="female" <%= gender === 'female' ? 'selected' : '' %>>Female</option>
              <option value="nonbinary" <%= gender === 'nonbinary' ? 'selected' : '' %>>Non-binary</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Age</label>
            <input
              type="number"
              name="age"
              min="0"
              max="120"
              class="form-control"
              value="<%= user && user.age ? user.age : '' %>"
            />
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label">Height</label>
            <% 
              const hUnit = (user && user.heightUnit) || 'cm';
              let hDisplay = '';
              if (user && user.heightCm) {
                if (hUnit === 'ft') {
                  hDisplay = (user.heightCm / 30.48).toFixed(1);
                } else {
                  hDisplay = user.heightCm;
                }
              }
            %>
            <div class="input-group">
              <input
                type="number"
                step="0.1"
                name="heightValue"
                class="form-control"
                value="<%= hDisplay %>"
              />
              <select name="heightUnit" class="form-select" style="max-width: 120px;">
                <option value="cm" <%= hUnit === 'cm' ? 'selected' : '' %>>cm</option>
                <option value="ft" <%= hUnit === 'ft' ? 'selected' : '' %>>ft</option>
              </select>
            </div>
          </div>

          <div class="col-md-6">
            <label class="form-label">Weight</label>
            <% 
              const wUnit = (user && user.weightUnit) || 'kg';
              let wDisplay = '';
              if (user && user.weightKg) {
                if (wUnit === 'lb') {
                  wDisplay = (user.weightKg / 0.453592).toFixed(1);
                } else {
                  wDisplay = user.weightKg;
                }
              }
            %>
            <div class="input-group">
              <input
                type="number"
                step="0.1"
                name="weightValue"
                class="form-control"
                value="<%= wDisplay %>"
              />
              <select name="weightUnit" class="form-select" style="max-width: 120px;">
                <option value="kg" <%= wUnit === 'kg' ? 'selected' : '' %>>kg</option>
                <option value="lb" <%= wUnit === 'lb' ? 'selected' : '' %>>lb</option>
              </select>
            </div>
          </div>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label">Primary goal</label>
            <% const goal = (user && user.primaryGoal) || 'general'; %>
            <select name="primaryGoal" class="form-select">
              <option value="general" <%= goal === 'general' ? 'selected' : '' %>>General fitness</option>
              <option value="muscle" <%= goal === 'muscle' ? 'selected' : '' %>>Build muscle</option>
              <option value="fatloss" <%= goal === 'fatloss' ? 'selected' : '' %>>Lose fat</option>
              <option value="strength" <%= goal === 'strength' ? 'selected' : '' %>>Increase strength</option>
              <option value="performance" <%= goal === 'performance' ? 'selected' : '' %>>Sports performance</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Training experience</label>
            <% const exp = (user && user.experience) || 'beginner'; %>
            <select name="experience" class="form-select">
              <option value="beginner" <%= exp === 'beginner' ? 'selected' : '' %>>Beginner (0–6 months)</option>
              <option value="intermediate" <%= exp === 'intermediate' ? 'selected' : '' %>>Intermediate (6–24 months)</option>
              <option value="advanced" <%= exp === 'advanced' ? 'selected' : '' %>>Advanced (2+ years)</option>
            </select>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-2">Save profile</button>
      </form>
    </div>
  </div>

  <!-- Right column: appearance + reminders -->
  <div class="col-lg-6 d-flex flex-column gap-4">
    <div class="glass-card p-4">
      <h3 class="mb-3">Appearance</h3>
      <p class="text-secondary mb-3">Choose between dark and light mode.</p>

      <form action="/account/theme" method="POST">
        <% const theme = (user && user.theme) || 'dark'; %>
        <div class="form-check mb-2">
          <input
            class="form-check-input"
            type="radio"
            name="theme"
            id="themeDark"
            value="dark"
            <%= theme === 'dark' ? 'checked' : '' %>
          />
          <label class="form-check-label" for="themeDark">
            Dark mode (recommended)
          </label>
        </div>
        <div class="form-check mb-3">
          <input
            class="form-check-input"
            type="radio"
            name="theme"
            id="themeLight"
            value="light"
            <%= theme === 'light' ? 'checked' : '' %>
          />
          <label class="form-check-label" for="themeLight">
            Light mode
          </label>
        </div>
        <button type="submit" class="btn btn-outline-light w-100">Save appearance</button>
      </form>
    </div>

    <div class="glass-card p-4">
      <h3 class="mb-3">Workout reminders</h3>
      <p class="text-secondary mb-3">
        Set a daily time to remind yourself to log workouts. (Future versions could send notifications.)
      </p>

      <form action="/account/reminders" method="POST">
        <% const reminderEnabled = user && user.reminderEnabled; %>
        <% const reminderTime = (user && user.reminderTime) || '18:00'; %>

        <div class="form-check form-switch mb-3">
          <input
            class="form-check-input"
            type="checkbox"
            id="reminderEnabled"
            name="reminderEnabled"
            <%= reminderEnabled ? 'checked' : '' %>
          />
          <label class="form-check-label" for="reminderEnabled">
            Enable daily reminder
          </label>
        </div>

        <div class="mb-3">
          <label class="form-label">Reminder time</label>
          <input
            type="time"
            name="reminderTime"
            class="form-control"
            value="<%= reminderTime %>"
          />
          <small class="text-secondary">
            This just stores your preferred time for now.
          </small>
        </div>

        <button type="submit" class="btn btn-primary w-100">Save reminder settings</button>
      </form>
    </div>
  </div>
</div>

<!-- Danger zone -->
<div class="glass-card p-4 mt-4 border border-danger-subtle" style="background: rgba(127,29,29,0.12);">
  <h4 class="text-danger mb-2">Danger zone</h4>
  <p class="text-secondary mb-3">
    Deleting your account will remove all workouts and data linked to this login. This cannot be undone.
  </p>
  <form action="/account/delete" method="POST" onsubmit="return confirm('Delete your account and all workout data?');">
    <button type="submit" class="btn btn-outline-danger">
      Delete my account
    </button>
  </form>
</div>

<%- include('../partials/footer') %>