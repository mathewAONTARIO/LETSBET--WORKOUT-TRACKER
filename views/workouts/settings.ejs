<%- include('../partials/header', { currentPath: '/workouts/settings' }) %>

<section class="mb-4">
  <h1 class="mb-2">Settings</h1>
  <p class="text-secondary mb-4">Customize your Lets Bet experience.</p>

  <div class="row g-4">

    <!-- PROFILE PIC + DISPLAY NAME + WEEKLY GOAL -->
    <div class="col-md-6">
      <div class="glass-card p-4 mb-4">
        <h5 class="mb-3">Profile</h5>

        <!-- Avatar upload -->
        <form
          action="/account/avatar"
          method="POST"
          enctype="multipart/form-data"
          class="mb-3 d-flex align-items-center gap-3 flex-wrap"
        >
          <div class="position-relative">
            <img
              src="<%= (user && user.avatarUrl) ? user.avatarUrl : '/img/letsbet-logo.png' %>"
              alt="Profile picture"
              style="width:64px;height:64px;border-radius:999px;object-fit:cover;border:2px solid rgba(148,163,184,0.6);"
            />
          </div>
          <div class="flex-grow-1">
            <label class="form-label mb-1">Profile picture</label>
            <input
              type="file"
              name="avatar"
              accept="image/*"
              class="form-control form-control-sm bg-dark text-light border-secondary"
            />
            <small class="text-secondary">PNG or JPG, up to 2MB.</small>
          </div>
          <button class="btn btn-outline-light btn-sm mt-2 mt-md-0" type="submit">
            Upload
          </button>
        </form>

        <!-- Display name + weekly goal -->
        <form action="/account" method="POST" class="vstack gap-3">
          <div>
            <label class="form-label">Display name</label>
            <input
              type="text"
              class="form-control bg-dark text-light border-secondary"
              name="displayName"
              value="<%= (user && user.displayName) || (currentUser && currentUser.displayName) || (currentUser && currentUser.email) || '' %>"
              required
            />
          </div>

          <div>
            <label class="form-label">Weekly workout goal</label>
            <input
              type="number"
              min="1"
              max="14"
              class="form-control bg-dark text-light border-secondary"
              name="weeklyGoal"
              value="<%= (user && user.weeklyGoal) || 4 %>"
              required
            />
            <small class="text-secondary">How many workouts you’re aiming for each week.</small>
          </div>

          <button class="btn btn-primary mt-2" type="submit">Save profile</button>
        </form>
      </div>
    </div>

    <!-- THEME + REMINDERS -->
    <div class="col-md-6">

      <!-- Theme -->
      <div class="glass-card p-4 mb-4">
        <h5 class="mb-3">Appearance</h5>
        <p class="text-secondary mb-3">Choose between dark and light mode.</p>

        <form action="/account/theme" method="POST" class="vstack gap-2">
          <div class="form-check">
            <input
              class="form-check-input"
              type="radio"
              name="theme"
              id="themeDark"
              value="dark"
              <%= currentTheme !== 'light' ? 'checked' : '' %>
            />
            <label class="form-check-label" for="themeDark">
              Dark mode (recommended)
            </label>
          </div>

          <div class="form-check">
            <input
              class="form-check-input"
              type="radio"
              name="theme"
              id="themeLight"
              value="light"
              <%= currentTheme === 'light' ? 'checked' : '' %>
            />
            <label class="form-check-label" for="themeLight">
              Light mode
            </label>
          </div>

          <button class="btn btn-outline-light btn-sm mt-3" type="submit">
            Save appearance
          </button>
        </form>
      </div>

      <!-- Reminders -->
      <div class="glass-card p-4 mb-4">
        <h5 class="mb-3">Workout reminders</h5>
        <p class="text-secondary mb-3">
          Set a daily reminder time to log your workouts.
        </p>

        <form action="/account/reminders" method="POST" class="vstack gap-3">
          <div class="form-check form-switch">
            <input
              class="form-check-input"
              type="checkbox"
              role="switch"
              id="reminderEnabled"
              name="reminderEnabled"
              <%= user && user.reminderEnabled ? 'checked' : '' %>
            />
            <label class="form-check-label" for="reminderEnabled">
              Enable daily reminder
            </label>
          </div>

          <div>
            <label class="form-label">Reminder time</label>
            <input
              type="time"
              class="form-control bg-dark text-light border-secondary"
              name="reminderTime"
              value="<%= user && user.reminderTime ? user.reminderTime : '' %>"
            />
            <small class="text-secondary">
              This just stores your preferred time – notifications would be a future feature.
            </small>
          </div>

          <button class="btn btn-primary btn-sm mt-2" type="submit">
            Save reminder settings
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- DANGER ZONE -->
  <div class="glass-card p-4 border-danger mt-2">
    <h5 class="mb-2 text-danger">Danger zone</h5>
    <p class="text-secondary mb-3">
      Deleting your account will remove all workouts and data linked to this login. This cannot be undone.
    </p>

    <form action="/account/delete" method="POST" onsubmit="return confirm('Delete your account and all workouts? This cannot be undone.');">
      <button type="submit" class="btn btn-outline-danger btn-sm">
        Delete my account
      </button>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>