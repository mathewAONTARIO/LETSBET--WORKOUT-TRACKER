<%- include('../partials/header', { currentPath: '/account/profile' }) %>

<h1 class="mb-2">Profile</h1>
<p class="text-secondary mb-4">Update your profile, goals, and reminder preferences.</p>

<div class="row g-4">

  <!-- PROFILE CARD -->
  <div class="col-lg-6">
    <div class="glass-card p-4 h-100">
      <h5 class="mb-3">Profile</h5>

      <!-- Upload + details saved together -->
      <form action="/account/profile" method="POST" enctype="multipart/form-data" class="mb-2">
        <div class="d-flex align-items-center gap-3">
          <img
            src="<%= currentUser.profilePhotoUrl || '/img/letsbet-logo.png' %>"
            alt="Profile picture"
            class="rounded-circle"
            style="width:56px;height:56px;object-fit:cover;"
          />
          <div class="flex-grow-1">
            <label class="form-label mb-1">Profile picture</label>
            <input type="file" name="profilePhoto" class="form-control form-control-sm" accept="image/png,image/jpeg" />
            <small class="text-secondary">PNG or JPG, up to 2MB.</small>
          </div>
        </div>

        <div class="mt-3">
          <label class="form-label">Display name</label>
          <input
            type="text"
            name="displayName"
            class="form-control"
            value="<%= currentUser.displayName || '' %>"
            required
          />
        </div>

        <div class="mt-3">
          <label class="form-label">Weekly workout goal</label>
          <select name="weeklyGoal" class="form-select">
            <% for (let i = 1; i <= 7; i++) { %>
              <option value="<%= i %>" <%= Number(currentUser.weeklyGoal) === i ? 'selected' : '' %>>
                <%= i %> workout<%= i === 1 ? '' : 's' %> per week
              </option>
            <% } %>
          </select>
          <small class="text-secondary">How many workouts you’re aiming for each week.</small>
        </div>

        <div class="row mt-2">
          <div class="col-md-4 mb-3">
            <label class="form-label">Gender</label>
            <select name="gender" class="form-select">
              <option value="">Not set</option>
              <option value="male" <%= currentUser.gender === 'male' ? 'selected' : '' %>>Male</option>
              <option value="female" <%= currentUser.gender === 'female' ? 'selected' : '' %>>Female</option>
              <option value="other" <%= currentUser.gender === 'other' ? 'selected' : '' %>>Other</option>
              <option value="prefer_not_say" <%= currentUser.gender === 'prefer_not_say' ? 'selected' : '' %>>Prefer not to say</option>
            </select>
          </div>

          <div class="col-md-4 mb-3">
            <label class="form-label">Age</label>
            <input
              type="number"
              name="age"
              min="0"
              max="120"
              class="form-control"
              value="<%= currentUser.age || '' %>"
            />
          </div>

          <div class="col-md-4 mb-3">
            <label class="form-label">Weight</label>
            <input
              type="text"
              name="weight"
              class="form-control"
              value="<%= currentUser.weightValue || '' %>"
              placeholder="e.g. 213"
            />
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Weight unit</label>
            <select name="weightUnit" class="form-select">
              <option value="kg" <%= currentUser.weightUnit === 'kg' ? 'selected' : '' %>>kg</option>
              <option value="lb" <%= currentUser.weightUnit === 'lb' ? 'selected' : '' %>>lb</option>
            </select>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Height</label>
            <input
              type="text"
              name="height"
              class="form-control"
              value="<%= currentUser.heightValue || '' %>"
              placeholder="e.g. 6'3 or 190"
            />
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Height unit</label>
            <select name="heightUnit" class="form-select">
              <option value="cm" <%= currentUser.heightUnit === 'cm' ? 'selected' : '' %>>cm</option>
              <option value="ft" <%= currentUser.heightUnit === 'ft' ? 'selected' : '' %>>ft</option>
            </select>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Target weight</label>
            <input
              type="text"
              name="targetWeight"
              class="form-control"
              value="<%= currentUser.targetWeightValue || '' %>"
              placeholder="e.g. 185"
            />
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Target unit</label>
            <select name="targetWeightUnit" class="form-select">
              <option value="kg" <%= currentUser.targetWeightUnit === 'kg' ? 'selected' : '' %>>kg</option>
              <option value="lb" <%= currentUser.targetWeightUnit === 'lb' ? 'selected' : '' %>>lb</option>
            </select>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Primary goal</label>
            <select name="primaryGoal" class="form-select">
              <option value="general-fitness" <%= currentUser.primaryGoal === 'general-fitness' ? 'selected' : '' %>>General fitness</option>
              <option value="fat-loss" <%= currentUser.primaryGoal === 'fat-loss' ? 'selected' : '' %>>Fat loss</option>
              <option value="muscle-gain" <%= currentUser.primaryGoal === 'muscle-gain' ? 'selected' : '' %>>Muscle gain</option>
              <option value="strength" <%= currentUser.primaryGoal === 'strength' ? 'selected' : '' %>>Strength</option>
              <option value="performance" <%= currentUser.primaryGoal === 'performance' ? 'selected' : '' %>>Performance</option>
              <option value="endurance" <%= currentUser.primaryGoal === 'endurance' ? 'selected' : '' %>>Endurance</option>
            </select>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Training experience</label>
            <select name="trainingExperience" class="form-select">
              <option value="beginner-0-6" <%= currentUser.trainingExperience === 'beginner-0-6' ? 'selected' : '' %>>Beginner (0–6 months)</option>
              <option value="intermediate-6-24" <%= currentUser.trainingExperience === 'intermediate-6-24' ? 'selected' : '' %>>Intermediate (6–24 months)</option>
              <option value="advanced-24-plus" <%= currentUser.trainingExperience === 'advanced-24-plus' ? 'selected' : '' %>>Advanced (2+ years)</option>
            </select>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-2">Save profile</button>
      </form>
    </div>
  </div>

  <!-- APPEARANCE + REMINDERS -->
  <div class="col-lg-6">
    <div class="glass-card p-4 mb-4">
      <h5 class="mb-3">Appearance</h5>
      <form action="/account/theme" method="POST">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="theme" id="themeDark" value="dark" <%= currentTheme === 'dark' ? 'checked' : '' %> />
          <label class="form-check-label" for="themeDark">Dark mode (recommended)</label>
        </div>
        <div class="form-check mt-2">
          <input class="form-check-input" type="radio" name="theme" id="themeLight" value="light" <%= currentTheme === 'light' ? 'checked' : '' %> />
          <label class="form-check-label" for="themeLight">Light mode</label>
        </div>
        <button type="submit" class="btn btn-outline-light w-100 mt-3">Save appearance</button>
      </form>
    </div>

    <div class="glass-card p-4 mb-4">
      <h5 class="mb-3">Workout reminders</h5>
      <form action="/account/reminder" method="POST">
        <div class="form-check form-switch mb-3">
          <input class="form-check-input" type="checkbox" id="reminderEnabled" name="enabled" <%= currentUser.dailyReminderEnabled ? 'checked' : '' %> />
          <label class="form-check-label" for="reminderEnabled">Enable daily reminder</label>
        </div>

        <div class="mb-2">
          <label class="form-label">Reminder time</label>
          <input type="time" name="time" class="form-control" value="<%= currentUser.reminderTime || '18:00' %>" />
        </div>

        <small class="text-secondary">This just stores your preferred time — notifications can be a future feature.</small>
        <button type="submit" class="btn btn-primary w-100 mt-3">Save reminder settings</button>
      </form>
    </div>
  </div>
</div>

<div class="glass-card p-4 mt-3 border border-danger-subtle" style="background:rgba(127,29,29,0.12);">
  <h5 class="mb-2 text-danger">Danger zone</h5>
  <p class="text-secondary mb-3">
    Deleting your account will remove all workouts and data linked to this login. This cannot be undone.
  </p>
  <form action="/account/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete your account? This cannot be undone.');">
    <button type="submit" class="btn btn-outline-danger">Delete my account</button>
  </form>
</div>

<%- include('../partials/footer') %>