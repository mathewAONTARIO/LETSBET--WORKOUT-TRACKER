<%- include('../partials/header', { currentPath: '/workouts' }) %>

<h2 class="mb-1">Workouts for <%= dateLabel %></h2>
<p class="text-secondary mb-4" style="font-size:0.9rem;">Summary of everything you logged that day.</p>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="glass-card h-100">
      <div class="card-body p-3">
        <h6 class="text-uppercase text-secondary mb-2" style="font-size:0.8rem;">Total Exercises</h6>
        <p class="h3 mb-0"><%= totalExercises %></p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="glass-card h-100">
      <div class="card-body p-3">
        <h6 class="text-uppercase text-secondary mb-2" style="font-size:0.8rem;">Total Volume</h6>
        <p class="h3 mb-0"><%= totalVolume %></p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="glass-card h-100">
      <div class="card-body p-3">
        <h6 class="text-uppercase text-secondary mb-2" style="font-size:0.8rem;">Total Weight (kg)</h6>
        <p class="h3 mb-0"><%= totalWeight %></p>
      </div>
    </div>
  </div>
</div>

<% if (workouts.length === 0) { %>
  <p class="text-secondary">No workouts logged on this day.</p>
<% } else { %>
  <div class="mt-3">
    <% workouts.forEach(workout => { %>
      <div class="workout-card">
        <div class="workout-main">
          <div class="workout-title"><%= workout.exercise %></div>
          <div class="workout-meta">
            <span><%= workout.sets %> × <%= workout.reps %></span>
            <% if (workout.weight) { %>
              · <span><%= workout.weight %> kg</span>
            <% } %>
          </div>
        </div>
        <div class="text-end">
          <div class="mb-1">
            <% const cat = (workout.category || 'Other'); %>
            <% const key = cat.toLowerCase().replace(' ','-'); %>
            <span class="badge-category badge-<%= key %>"><%= cat %></span>
            <% if (workout.weight) { 
                 const exKey = workout.exercise.toLowerCase();
                 if (prsByExercise && prsByExercise[exKey] === workout.weight) { %>
              <span class="badge-pr">PR</span>
            <% } } %>
          </div>
          <div class="d-flex justify-content-end gap-1">
            <a href="/workouts/<%= workout._id %>/edit" class="btn btn-sm btn-outline-light">Edit</a>
            <form action="/workouts/<%= workout._id %>/duplicate" method="POST">
              <button type="submit" class="btn btn-sm btn-outline-light">Duplicate</button>
            </form>
            <a href="/workouts/<%= workout._id %>/delete" class="btn btn-sm btn-outline-danger">Delete</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>