<%- include('../partials/header', { currentPath: '/workouts/calendar' }) %>

<h2 class="mb-1">Workouts for <%= selectedDate %></h2>
<p class="text-secondary mb-4">Here are the sessions you logged on this day.</p>

<% if (!workouts || workouts.length === 0) { %>
  <div class="glass-card p-4 mb-3">
    <p class="mb-0 text-secondary">No workouts logged for this date.</p>
  </div>
<% } else { %>
  <% workouts.forEach(w => { %>
    <div class="workout-card">
      <div class="workout-main">
        <div class="workout-title">
          <%= w.exercise %>
          <% if (w.isPR) { %>
            <span class="badge-pr">PR</span>
          <% } %>
        </div>
        <div class="workout-meta">
          <%= w.sets %> × <%= w.reps %>
          <% if (w.weight) { %> · <%= w.weight %> kg <% } %>
          <% if (w.notes) { %> · <%= w.notes %> <% } %>
        </div>
      </div>
      <div class="text-end">
        <a href="/workouts/<%= w._id %>/edit" class="btn btn-sm btn-outline-light me-2">Edit</a>
        <a href="/workouts/<%= w._id %>/delete" class="btn btn-sm btn-outline-light">Delete</a>
      </div>
    </div>
  <% }) %>
<% } %>

<a href="/workouts/calendar" class="btn btn-outline-light mt-3">Back to Calendar</a>

<%- include('../partials/footer') %>