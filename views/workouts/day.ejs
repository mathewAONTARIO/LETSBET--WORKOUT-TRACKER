<%- include('../partials/header', { currentPath: '/workouts/calendar' }) %>

<h2 class="mb-1">Workouts for <%= selectedDate %></h2>
<p class="text-secondary mb-3">Here are the sessions you logged on this day.</p>

<a href="/workouts/day/<%= selectedDate %>/new" class="btn btn-primary mb-3">
  Add Workout for <%= selectedDate %>
</a>

<% if (workouts.length === 0) { %>
  <div class="glass-card p-3 mb-3">
    <p class="text-secondary">No workouts logged for this date.</p>
  </div>
<% } else { %>
  <% workouts.forEach(w => { %>
    <div class="workout-card mb-3">
      <div>
        <div class="workout-title"><%= w.exercise %></div>
        <div class="workout-meta">
          <%= w.sets %> x <%= w.reps %> · <%= w.weight %> kg · <%= w.category %>
        </div>
      </div>

      <div class="workout-actions">
        <a href="/workouts/<%= w._id %>/edit" class="btn btn-outline-light btn-sm">Edit</a>
        <a href="/workouts/<%= w._id %>/delete" class="btn btn-outline-danger btn-sm">Delete</a>
      </div>
    </div>
  <% }) %>
<% } %>

<a href="/workouts/calendar" class="btn btn-outline-light mt-3">
  Back to Calendar
</a>

<%- include('../partials/footer') %>