<%- include('../partials/header', { currentPath: '/workouts/library' }) %>

<h2 class="mb-1">Exercise Library</h2>
<p class="text-secondary mb-4">
  Quick ideas for what to hit each day. Use these to build or tweak your workouts.
</p>

<div class="glass-card mb-4">
  <div class="card-body">
    <h5 class="mb-2">Sample push / pull / legs split</h5>
    <p class="text-secondary" style="font-size:0.9rem;">
      Use 3–4 moves per day, 3–4 sets each, 6–12 reps depending on your goal.
    </p>
    <div class="library-grid mt-3">
      <div class="library-card">
        <div class="library-card-title">Push (chest, shoulders, triceps)</div>
        <div class="library-card-sub">Example day:</div>
        <ul class="mb-0">
          <li>Bench Press – 4×6–8</li>
          <li>Incline Dumbbell Press – 3×8–10</li>
          <li>Seated Shoulder Press – 3×8–10</li>
          <li>Triceps Pushdowns – 3×10–12</li>
        </ul>
      </div>
      <div class="library-card">
        <div class="library-card-title">Pull (back, biceps)</div>
        <div class="library-card-sub">Example day:</div>
        <ul class="mb-0">
          <li>Deadlift or RDL – 3×5–6</li>
          <li>Lat Pulldown / Pull-Ups – 4×6–10</li>
          <li>Barbell or Dumbbell Row – 3×8–10</li>
          <li>Biceps Curls – 3×10–12</li>
        </ul>
      </div>
      <div class="library-card">
        <div class="library-card-title">Legs (quads, glutes, hamstrings)</div>
        <div class="library-card-sub">Example day:</div>
        <ul class="mb-0">
          <li>Back Squat or Hack Squat – 4×6–8</li>
          <li>Romanian Deadlift – 3×8–10</li>
          <li>Leg Press or Lunges – 3×10–12</li>
          <li>Calf Raises – 3×12–15</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<div class="glass-card mb-4">
  <div class="card-body">
    <h5 class="mb-3">Exercise ideas by muscle group</h5>
    <div class="library-grid">
      <div class="library-card">
        <div class="library-card-title">Chest</div>
        <div class="library-card-sub">Pick 2–3:</div>
        <ul class="mb-0">
          <li>Bench Press</li>
          <li>Incline Dumbbell Press</li>
          <li>Push-Ups / Weighted Push-Ups</li>
          <li>Cable Flyes or Pec Deck</li>
        </ul>
      </div>
      <div class="library-card">
        <div class="library-card-title">Back</div>
        <div class="library-card-sub">Vertical + horizontal pull:</div>
        <ul class="mb-0">
          <li>Lat Pulldown / Pull-Ups</li>
          <li>Barbell or Dumbbell Row</li>
          <li>Chest-Supported Row</li>
          <li>Face Pulls</li>
        </ul>
      </div>
      <div class="library-card">
        <div class="library-card-title">Legs</div>
        <div class="library-card-sub">Hit quads + glutes + hamstrings:</div>
        <ul class="mb-0">
          <li>Back or Front Squat</li>
          <li>Leg Press</li>
          <li>Romanian Deadlift</li>
          <li>Walking Lunges</li>
        </ul>
      </div>
      <div class="library-card">
        <div class="library-card-title">Shoulders</div>
        <div class="library-card-sub">Front / side / rear delts:</div>
        <ul class="mb-0">
          <li>Overhead Press</li>
          <li>Lateral Raises</li>
          <li>Rear Delt Flyes</li>
          <li>Arnold Press</li>
        </ul>
      </div>
      <div class="library-card">
        <div class="library-card-title">Arms</div>
        <div class="library-card-sub">After push / pull work:</div>
        <ul class="mb-0">
          <li>Barbell or DB Curls</li>
          <li>Hammer Curls</li>
          <li>Triceps Pushdowns</li>
          <li>Dips or Bench Dips</li>
        </ul>
      </div>
      <div class="library-card">
        <div class="library-card-title">Core / conditioning</div>
        <div class="library-card-sub">Finishers:</div>
        <ul class="mb-0">
          <li>Planks (front / side)</li>
          <li>Hanging Leg Raises</li>
          <li>Cable Crunches</li>
          <li>Bike, rower, or incline walk 10–20 min</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>