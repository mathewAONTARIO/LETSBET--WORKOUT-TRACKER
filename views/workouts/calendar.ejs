<%- include('../partials/header', { currentPath: '/workouts/calendar' }) %>

<div class="main-shell calendar-shell">
  <h2 class="mb-1">Calendar</h2>
  <p class="text-secondary mb-4">
    See your workouts on a monthly calendar.
  </p>

  <div class="d-flex justify-content-between align-items-center calendar-nav-row mb-3">
    <a class="btn btn-outline-light btn-sm" href="/workouts/calendar?month=<%= prevMonthParam %>">
      &larr; Previous
    </a>

    <h5 class="mb-0"><%= monthLabel %></h5>

    <a class="btn btn-outline-light btn-sm" href="/workouts/calendar?month=<%= nextMonthParam %>">
      Next &rarr;
    </a>
  </div>

  <div class="glass-card p-4 mt-2">
    <!-- Week day labels -->
    <div class="calendar-weekdays mb-2">
      <div>Sun</div>
      <div>Mon</div>
      <div>Tue</div>
      <div>Wed</div>
      <div>Thu</div>
      <div>Fri</div>
      <div>Sat</div>
    </div>

    <!-- Calendar grid -->
    <div class="calendar-grid">
      <% days.forEach(function(day) { 
        const classes = ['calendar-day'];
        if (!day.inMonth) classes.push('calendar-day-outside');
        if (day.hasWorkout) classes.push('has-workout');
        if (day.intensity) classes.push('intensity-' + day.intensity);
        if (day.isToday) classes.push('today');
        if (day.isFuture && day.hasWorkout) classes.push('future-scheduled'); // future scheduled
      %>
        <a
          href="/workouts/day/<%= day.label %>"
          class="<%= classes.join(' ') %>"
          data-date="<%= day.label %>"
        >
          <span><%= day.day %></span>
        </a>
      <% }) %>
    </div>

    <p class="mt-3 text-secondary" style="font-size: 0.85rem;">
      Blue = days you already trained. 
      <span style="color:#22d3ee;">Cyan</span> = workouts you’ve scheduled for future days. 
      Today has an orange glow. Faded numbers are days from the previous or next month.
    </p>
  </div>
</div>

<script>
  // Force "today" highlight using the browser's local date
  (function () {
    try {
      var now = new Date();
      var yyyy = now.getFullYear();
      var mm = String(now.getMonth() + 1).padStart(2, '0');
      var dd = String(now.getDate()).padStart(2, '0');
      var todayKey = yyyy + '-' + mm + '-' + dd;

      var cells = document.querySelectorAll('.calendar-day[data-date]');
      cells.forEach(function (cell) {
        if (cell.dataset.date === todayKey) {
          cell.classList.add('today');
        } else {
          cell.classList.remove('today');
        }
      });
    } catch (e) {
      console.error('Calendar today highlight error', e);
    }
  })();
</script>

<%- include('../partials/footer') %>