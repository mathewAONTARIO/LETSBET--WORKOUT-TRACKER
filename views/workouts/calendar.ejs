<%- include('../partials/header', { currentPath: '/workouts/calendar' }) %>

<h2 class="mb-1">Calendar</h2>
<p class="text-secondary mb-4">See your workouts on a monthly calendar.</p>

<div class="d-flex justify-content-between align-items-center mb-3">
  <a href="/workouts/calendar?month=<%= prevMonthParam %>" class="btn btn-outline-light btn-sm">
    &larr; Previous
  </a>
  <h4 class="mb-0"><%= monthLabel %></h4>
  <a href="/workouts/calendar?month=<%= nextMonthParam %>" class="btn btn-outline-light btn-sm">
    Next &rarr;
  </a>
</div>

<div class="glass-card mb-3">
  <div class="card-body p-3">

    <div class="calendar-weekdays d-none d-md-grid">
      <div>Sun</div>
      <div>Mon</div>
      <div>Tue</div>
      <div>Wed</div>
      <div>Thu</div>
      <div>Fri</div>
      <div>Sat</div>
    </div>

    <div class="calendar-grid calendar-grid-month">
      <% days.forEach(d => { %>
        <a
          href="/workouts/day/<%= d.label %>"
          class="calendar-day intensity-<%= d.intensity %>
                 <%= d.hasWorkout ? ' has-workout' : '' %>
                 <%= d.isToday ? ' today' : '' %>
                 <%= d.inMonth ? '' : ' calendar-day-outside' %>">
          <div><%= d.day %></div>
        </a>
      <% }) %>
    </div>
  </div>
</div>

<p class="text-secondary" style="font-size: 0.85rem;">
  Blue = days you trained. Orange outline = today. Faded numbers are days from the previous or next month.
</p>

<%- include('../partials/footer') %>