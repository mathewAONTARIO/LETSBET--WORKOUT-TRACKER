<%- include('../partials/header', { currentPath: '/workouts/stats' }) %>

<h2 class="mb-1">Stats</h2>
<p class="text-secondary mb-4">See how your training volume is trending over time.</p>

<div class="glass-card mb-4">
  <div class="card-body p-3">
    <canvas id="volumeChart" height="90"></canvas>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="glass-card">
      <div class="card-body p-3">
        <h6 class="text-uppercase text-secondary mb-2" style="font-size: 0.8rem;">Total Workouts Logged</h6>
        <p class="h3 mb-0"><%= totalWorkouts %></p>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="glass-card">
      <div class="card-body p-3">
        <h6 class="text-uppercase text-secondary mb-2" style="font-size: 0.8rem;">Total Weight Entered (kg)</h6>
        <p class="h3 mb-0"><%= totalWeight %></p>
      </div>
    </div>
  </div>
</div>

<div class="glass-card mt-2 mb-3">
  <div class="card-body p-3">
    <h6 class="text-uppercase text-secondary mb-3" style="font-size:0.8rem;">Personal Bests</h6>
    <% if (!prs || prs.length === 0) { %>
      <p class="text-secondary mb-0" style="font-size:0.9rem;">Log some workouts with weight to see your PRs here.</p>
    <% } else { %>
      <div class="row">
        <% prs.forEach(pr => { %>
          <div class="col-md-4 mb-2">
            <div class="d-flex justify-content-between align-items-center text-secondary" style="font-size:0.9rem;">
              <span><strong><%= pr.exercise %></strong></span>
              <span><%= pr.weight %> kg</span>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<a href="/workouts/prs" class="btn btn-outline-light">View All PRs</a>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const ctx = document.getElementById('volumeChart').getContext('2d');
  const labels = <%- labels %>;
  const data = <%- data %>;

  new Chart(ctx, {
    type: 'line',
    data: {
      labels,
      datasets: [{
        label: 'Volume (sets × reps × weight)',
        data,
        tension: 0.35,
        borderWidth: 2,
        fill: true
      }]
    },
    options: {
      plugins: {
        legend: { labels: { color: '#e5e7eb' } }
      },
      scales: {
        x: {
          ticks: { color: '#9ca3af' },
          grid: { color: 'rgba(55,65,81,0.4)' }
        },
        y: {
          ticks: { color: '#9ca3af' },
          grid: { color: 'rgba(55,65,81,0.4)' }
        }
      }
    }
  });
</script>

<%- include('../partials/footer') %>