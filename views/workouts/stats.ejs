<%- include('../partials/header', { currentPath: '/workouts/stats' }) %>

<div class="main-shell">
  <h2 class="mb-1">Stats</h2>
  <p class="text-secondary mb-4">
    See how your training volume is trending over time.
  </p>

  <!-- Top summary row -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="glass-card p-3 h-100 d-flex flex-column justify-content-between">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <span class="text-secondary" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em;">
            Total workouts
          </span>
          <span style="font-size: 0.85rem; opacity: 0.8;">Lifetime</span>
        </div>
        <div style="font-size: 1.8rem; font-weight: 700;">
          <%= totalWorkouts %>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="glass-card p-3 h-100 d-flex flex-column justify-content-between">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <span class="text-secondary" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em;">
            Total volume
          </span>
          <span style="font-size: 0.85rem; opacity: 0.8;">sets × reps × weight</span>
        </div>
        <div style="font-size: 1.5rem; font-weight: 700;">
          <%= totalWeight.toLocaleString() %>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="glass-card p-3 h-100 d-flex flex-column justify-content-between">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <span class="text-secondary" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em;">
            Personal bests
          </span>
          <span style="font-size: 0.85rem; opacity: 0.8;">Tracked by exercise</span>
        </div>
        <div style="font-size: 1.5rem; font-weight: 700;">
          <%= prs.length %> PR<%= prs.length === 1 ? '' : 's' %>
        </div>
      </div>
    </div>
  </div>

  <!-- Volume chart card -->
  <div class="glass-card p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h5 class="mb-0">Volume over time</h5>
      <small class="text-secondary">
        Last 12 training days · Volume = sets × reps × weight
      </small>
    </div>

    <% if (JSON.parse(labels || '[]').length === 0) { %>
      <p class="text-secondary mb-0" style="font-size: 0.9rem;">
        Log a few workouts with weight to see your training volume chart.
      </p>
    <% } else { %>
      <div style="width: 100%; max-width: 100%; height: 260px;">
        <canvas id="volumeChart"></canvas>
      </div>
    <% } %>
  </div>

  <!-- PR table -->
  <div class="glass-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h5 class="mb-0">Personal records</h5>
      <small class="text-secondary">Mark sets as PR when you log a workout.</small>
    </div>

    <% if (prs.length === 0) { %>
      <p class="text-secondary mb-0" style="font-size: 0.9rem;">
        No PRs yet. Log some heavy sets and mark them as “PR” to track your best lifts.
      </p>
    <% } else { %>
      <