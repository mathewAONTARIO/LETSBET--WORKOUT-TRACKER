<%- include('../partials/header', { currentPath: '/workouts/stats' }) %>

<h2 class="mb-1">Stats</h2>
<p class="text-secondary mb-4">
  See how your training volume is trending over time.
</p>

<div class="glass-card p-4 mb-4">
  <h6 class="mb-3">Volume over time</h6>
  <canvas id="volumeChart" height="110"></canvas>
</div>

<div class="streak-grid mb-4">
  <div class="streak-card">
    <div class="streak-label">Total workouts logged</div>
    <div class="streak-value"><%= totalWorkouts || 0 %></div>
    <div class="streak-subtext">
      Every session counts toward the bigger picture.
    </div>
  </div>

  <div class="streak-card">
    <div class="streak-label">Total weight entered (kg)</div>
    <div class="streak-value"><%= totalWeight || 0 %></div>
    <div class="streak-subtext">
      Sum of sets × reps × weight across all logged workouts.
    </div>
  </div>

  <div class="streak-card">
    <div class="streak-label">Consistency snapshot</div>
    <div class="streak-subtext mt-2">
      Check your <a href="/workouts/streak">streak page</a> to see how many days
      in a row you've been moving.
    </div>
  </div>
</div>

<div class="glass-card p-4">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h6 class="mb-0">Personal bests</h6>
    <span class="text-secondary" style="font-size: 0.85rem;">
      Logged using the PR checkbox on workouts.
    </span>
  </div>

  <% if (prs && prs.length > 0) { %>
    <div class="table-responsive mt-2">
      <table class="table table-dark table-sm align-middle mb-0">
        <thead>
          <tr>
            <th scope="col">Exercise</th>
            <th scope="col">Best weight (kg)</th>
          </tr>
        </thead>
        <tbody>
          <% prs.forEach(function(pr) { %>
            <tr>
              <td><%= pr.exercise %></td>
              <td><%= pr.weight %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="text-secondary mb-0" style="font-size: 0.9rem;">
      Log some workouts with weight and mark them as PRs to see your best lifts here.
    </p>
  <% } %>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  (function () {
    const ctx = document.getElementById('volumeChart');
    if (!ctx) return;

    const labels = <%- labels %>;
    const data = <%- data %>;

    new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [
          {
            label: 'Volume (sets × reps × weight)',
            data: data,
            fill: true
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: {
            ticks: { color: '#cbd5f5' },
            grid: { display: false }
          },
          y: {
            ticks: { color: '#cbd5f5' },
            grid: { color: 'rgba(148, 163, 184, 0.25)' }
          }
        },
        plugins: {
          legend: {
            labels: { color: '#e5e7eb' }
          }
        }
      }
    });
  })();
</script>

<%- include('../partials/footer') %>