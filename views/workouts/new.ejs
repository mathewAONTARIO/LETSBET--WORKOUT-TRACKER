<%- include('../partials/header', { currentPath: '/workouts' }) %>

<div class="main-shell">
  <h2 class="mb-1">Add Workout</h2>
  <p class="text-secondary mb-4">
    Log a new workout session.
  </p>

  <form action="<%= formAction %>" method="POST" class="glass-card p-4">
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Exercise</label>
        <input
          type="text"
          name="exercise"
          class="form-control"
          placeholder="bench press, pull ups, run, etc."
          required
        />
      </div>

      <div class="col-md-6">
        <label class="form-label">Category</label>
        <select name="category" class="form-select">
          <option value="Upper Body">Upper Body</option>
          <option value="Lower Body">Lower Body</option>
          <option value="Push">Push</option>
          <option value="Pull">Pull</option>
          <option value="Legs">Legs</option>
          <option value="Full Body">Full Body</option>
          <option value="Cardio">Cardio</option>
          <option value="Core">Core</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Sets</label>
        <input type="number" name="sets" class="form-control" value="3" min="1" />
      </div>

      <div class="col-md-3">
        <label class="form-label">Reps</label>
        <input type="number" name="reps" class="form-control" value="8" min="1" />
      </div>

      <div class="col-md-3">
        <label class="form-label">Weight (kg)</label>
        <input type="number" name="weight" class="form-control" value="0" min="0" />
      </div>

      <div class="col-md-3">
        <label class="form-label">Date</label>
        <input
          type="date"
          name="date"
          class="form-control"
          value="<%= today %>"
          required
        />
      </div>

      <div class="col-12">
        <label class="form-label">Notes</label>
        <textarea
          name="notes"
          class="form-control"
          rows="3"
          placeholder="How did it feel? PRs, tempo, etc."
        ></textarea>
      </div>

      <div class="col-12">
        <div class="form-check">
          <input
            class="form-check-input"
            type="checkbox"
            id="isPR"
            name="isPR"
          />
          <label class="form-check-label" for="isPR">
            Mark as PR (personal record)
          </label>
        </div>
      </div>
    </div>

    <div class="mt-4 d-flex gap-2">
      <button type="submit" class="btn btn-primary">Save Workout</button>
      <a href="/workouts" class="btn btn-outline-light">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>