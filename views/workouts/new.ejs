<%- include('../partials/header', { currentPath: '/workouts' }) %>

<div class="main-shell">
  <h2 class="mb-1"><%= duplicateOf ? 'Duplicate Workout' : 'Add Workout' %></h2>
  <p class="text-secondary mb-4">
    <%= duplicateOf ? 'Start from an existing workout and tweak anything you need.' : 'Log a new workout session.' %>
  </p>

  <form action="<%= formAction %>" method="POST" class="glass-card p-4">
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Exercise</label>
        <input
          type="text"
          name="exercise"
          class="form-control"
          placeholder="bench press, pull ups, run, etc."
          value="<%= duplicateOf ? duplicateOf.exercise : '' %>"
          required
        />
      </div>

      <div class="col-md-6">
        <label class="form-label">Category</label>
        <select name="category" class="form-select">
          <% const dupCat = duplicateOf ? (duplicateOf.category || '') : ''; %>
          <option value="Upper Body" <%= dupCat === 'Upper Body' ? 'selected' : '' %>>
            Upper Body
          </option>
          <option value="Lower Body" <%= dupCat === 'Lower Body' ? 'selected' : '' %>>
            Lower Body
          </option>
          <option value="Push" <%= dupCat === 'Push' ? 'selected' : '' %>>
            Push
          </option>
          <option value="Pull" <%= dupCat === 'Pull' ? 'selected' : '' %>>
            Pull
          </option>
          <option value="Legs" <%= dupCat === 'Legs' ? 'selected' : '' %>>
            Legs
          </option>
          <option value="Full Body" <%= dupCat === 'Full Body' ? 'selected' : '' %>>
            Full Body
          </option>
          <option value="Cardio" <%= dupCat === 'Cardio' ? 'selected' : '' %>>
            Cardio
          </option>
          <option value="Core" <%= dupCat === 'Core' ? 'selected' : '' %>>
            Core
          </option>
          <option value="Other" <%= dupCat === 'Other' ? 'selected' : '' %>>
            Other
          </option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Sets</label>
        <input
          type="number"
          name="sets"
          id="setsInput"
          class="form-control"
          value="<%= duplicateOf && duplicateOf.sets != null ? duplicateOf.sets : 3 %>"
          min="1"
        />
      </div>

      <div class="col-md-3">
        <label class="form-label">Reps</label>
        <input
          type="number"
          name="reps"
          id="repsInput"
          class="form-control"
          value="<%= duplicateOf && duplicateOf.reps != null ? duplicateOf.reps : 8 %>"
          min="1"
        />
      </div>

      <div class="col-md-3">
        <label class="form-label">Weight (kg)</label>
        <input
          type="number"
          name="weight"
          id="weightInput"
          class="form-control"
          value="<%= duplicateOf && duplicateOf.weight != null ? duplicateOf.weight : 0 %>"
          min="0"
        />
      </div>

      <div class="col-md-3">
        <label class="form-label">Date</label>
        <input
          type="date"
          name="date"
          class="form-control"
          value="<%= today %>"
          required
        />
      </div>

      <div class="col-12">
        <label class="form-label">Notes</label>
        <textarea
          name="notes"
          class="form-control"
          rows="3"
          placeholder="How did it feel? PRs, tempo, etc."
        ><%= duplicateOf && duplicateOf.notes ? duplicateOf.notes : '' %></textarea>
      </div>

      <div class="col-12">
        <div class="form-check">
          <input
            class="form-check-input"
            type="checkbox"
            id="isPR"
            name="isPR"
            <%= duplicateOf && duplicateOf.isPR ? 'checked' : '' %>
          />
          <label class="form-check-label" for="isPR">
            Mark as PR (personal record)
          </label>
        </div>
      </div>

      <!-- Live volume display (MVP stat) -->
      <div class="col-12 mt-2">
        <small class="text-secondary">
          Estimated volume:
          <span id="volumeDisplay">0</span>
          (<span id="volumeFormula">sets × reps × weight</span>)
        </small>
      </div>
    </div>

    <div class="mt-4 d-flex gap-2">
      <button type="submit" class="btn btn-primary">
        <%= duplicateOf ? 'Save Duplicate' : 'Save Workout' %>
      </button>
      <a href="/workouts" class="btn btn-outline-light">Cancel</a>
    </div>
  </form>
</div>

<script>
  // Simple front-end helper for MVP:
  // live volume = sets * reps * weight
  document.addEventListener('DOMContentLoaded', () => {
    const setsInput = document.getElementById('setsInput');
    const repsInput = document.getElementById('repsInput');
    const weightInput = document.getElementById('weightInput');
    const volumeDisplay = document.getElementById('volumeDisplay');

    function updateVolume() {
      const sets = parseInt(setsInput.value, 10) || 0;
      const reps = parseInt(repsInput.value, 10) || 0;
      const weight = parseFloat(weightInput.value) || 0;

      const volume = sets * reps * weight;
      volumeDisplay.textContent = volume.toLocaleString();
    }

    ['input', 'change'].forEach(evt => {
      setsInput.addEventListener(evt, updateVolume);
      repsInput.addEventListener(evt, updateVolume);
      weightInput.addEventListener(evt, updateVolume);
    });

    // initialize on load
    updateVolume();
  });
</script>

<%- include('../partials/footer') %>