<%- include('../partials/header', { currentPath: '/auth/login' }) %>

<div class="row justify-content-center">
  <div class="col-md-7 col-lg-5">
    <div class="glass-card p-4">
      <h2 class="mb-2 text-center">Resend verification</h2>
      <p class="text-secondary text-center mb-3" style="font-size:0.95rem;">
        Enter your email and we’ll send a new verification link.
      </p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger py-2"><%= error %></div>
      <% } %>

      <% if (typeof info !== 'undefined' && info) { %>
        <div class="alert alert-success py-2"><%= info %></div>
      <% } %>

      <form action="/auth/resend-verification" method="POST" class="mt-3">
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" required autocomplete="email" value="<%= email || '' %>" />
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-2">Send verification email</button>
      </form>

      <p class="mt-3 mb-0 text-center">
        <a href="/auth/login">Back to login</a>
      </p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>