<%- include('../partials/header', { currentPath: '/auth/login' }) %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-4">
    <div class="glass-card p-4">
      <h2 class="mb-3 text-center">Log In</h2>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger py-2"><%= error %></div>
      <% } %>

      <% if (typeof info !== 'undefined' && info) { %>
        <div class="alert alert-info py-2"><%= info %></div>
      <% } %>

      <form action="/auth/login" method="POST" class="mt-3">
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input
            type="email"
            name="email"
            class="form-control"
            required
            autocomplete="email"
            value="<%= email || '' %>"
          />
        </div>

        <div class="mb-3">
          <label class="form-label">Password</label>
          <div class="input-group">
            <input
              id="loginPassword"
              type="password"
              name="password"
              class="form-control"
              required
              autocomplete="current-password"
            />
            <button
              class="btn btn-outline-light"
              type="button"
              id="toggleLoginPassword"
              aria-label="Show password"
            >
              Show
            </button>
          </div>
        </div>

        <div class="d-flex justify-content-between mb-2">
          <% if (showResend) { %>
            <a
              href="/auth/resend-verification?email=<%= encodeURIComponent(email || '') %>"
              class="text-secondary"
              style="font-size: 0.9rem;"
            >
              Resend verification
            </a>
          <% } else { %>
            <span></span>
          <% } %>

          <a href="/auth/forgot" class="text-secondary" style="font-size: 0.9rem;">
            Forgot password?
          </a>
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-2">Log In</button>
      </form>

      <p class="mt-3 mb-0 text-center">
        Need an account?
        <a href="/auth/register">Sign up</a>
      </p>
    </div>
  </div>
</div>

<script>
  (function () {
    const input = document.getElementById('loginPassword');
    const btn = document.getElementById('toggleLoginPassword');
    if (!input || !btn) return;

    btn.addEventListener('click', () => {
      const isHidden = input.type === 'password';
      input.type = isHidden ? 'text' : 'password';
      btn.textContent = isHidden ? 'Hide' : 'Show';
      btn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
    });
  })();
</script>

<%- include('../partials/footer') %>