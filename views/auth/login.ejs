<%- include('../partials/header', { currentPath: '/auth/login' }) %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-4">
    <div class="glass-card p-4">
      <h2 class="mb-3 text-center">Log In</h2>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger py-2"><%= error %></div>
      <% } %>

      <form action="/auth/login" method="POST" class="mt-3">
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" required />
        </div>

        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" required />
        </div>

        <div class="d-flex justify-content-end mb-2">
          <a href="/auth/forgot" class="text-secondary" style="font-size: 0.9rem;">
            Forgot password?
          </a>
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-2">Log In</button>
      </form>

      <p class="mt-3 mb-0 text-center">
        Need an account?
        <a href="/auth/register">Sign up</a>
      </p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>