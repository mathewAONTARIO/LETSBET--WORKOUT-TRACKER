<%- include('../partials/header', { currentPath: '/auth/register' }) %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-4">
    <div class="glass-card p-4">
      <h2 class="mb-3 text-center">Create Account</h2>
      <% if (error) { %>
        <div class="alert alert-danger py-2"><%= error %></div>
      <% } %>
      <form action="/auth/register" method="POST" class="mt-3">
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Display Name</label>
          <input type="text" name="displayName" class="form-control" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" name="password" class="form-control" required minlength="6" />
        </div>
        <button type="submit" class="btn btn-primary w-100 mt-2">Sign Up</button>
      </form>
      <p class="mt-3 mb-0 text-center">
        Already have an account?
        <a href="/auth/login">Log in</a>
      </p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>